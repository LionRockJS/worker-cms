<div class="my-4 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{ backHref }}" class="inline-flex shrink-0 items-center gap-1 text-xs text-gray-500 transition-colors hover:text-indigo-700">
      <span aria-hidden="true">&larr;</span>
      {{ "common.back" | t }}
    </a>
    {% if isEdit %}
      <a href="{{ readHref }}"
         title="{{ "view_strings.sections_editor.read_only_view" | t }}"
         class="ml-auto inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#eye"></use></svg>
        {{ "view_strings.sections_editor.view" | t }}
      </a>
      <div id="presence-bar"
           class="flex items-center gap-1.5 shrink-0"
           data-page-id="{{ page.id }}"
           data-user-id="{{ currentUserId }}"
           data-user-avatar="{{ userAvatar }}">
        <div id="presence-avatars" class="flex items-center gap-1"></div>
        <div id="sync-indicator"
             title=""
             data-title-connected="{{ "view_strings.sections_editor.sync_active" | t }}"
             data-title-connecting="{{ "view_strings.sections_editor.sync_connecting" | t }}"
             data-title-disconnected="{{ "view_strings.sections_editor.sync_disconnected" | t }}"
             style="width:8px;height:8px;border-radius:50%;background:#9ca3af;flex-shrink:0;transition:background .4s,opacity .4s;display:none"></div>
      </div>
    {% endif %}
  </div>

  {% if hasErrors %}
    <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4">
      <p class="text-sm font-semibold text-red-700 mb-1">{{ "view_strings.sections_editor.please_fix_the_following_errors" | t }}</p>
      <ul class="list-disc list-inside text-sm text-red-600">
        {% for error in errors %}
          <li>{{ error }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if hasFlash %}
    <div id="flash" class="mb-6 rounded-lg bg-green-50 border border-green-200 p-3 text-sm text-green-700 flex items-center gap-2">
      <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><use href="{{ iconHrefPrefix }}#check-circle"></use></svg>
      {{ flash | t }}
    </div>
  {% endif %}

  <form method="POST" action="{{ action }}" data-editor-form data-editor-mode="{% if isEdit %}edit{% else %}new{% endif %}" class="min-w-0 space-y-6">
    <input type="hidden" name="return_to" value="{{ backHref }}">
    {% if isVersionPreview %}
      <button type="submit" name="action" value="{{ selectedVersion.restoreAction }}" class="sr-only" tabindex="-1" aria-hidden="true">{{ "view_strings.sections_editor.restore_version" | t }}</button>
    {% else %}
      <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">{% if isEdit %}{{ "view_strings.sections_editor.save_changes" | t }}{% else %}{{ "view_strings.sections_editor.create_page" | t }}{% endif %}</button>
    {% endif %}
    <div class="flex flex-col md:flex-row md:gap-4 mb-4 pb-4 border-b border-gray-200">
      <!-- start page edit header -->
      <div class="w-full min-w-0">
        {% if isVersionPreview %}
          <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-amber-700">version: {{ selectedVersion.createdAt | l10n_date }}</div>
        {% endif %}
        <label for="page-name" class="sr-only">{{ "view_strings.sections_editor.page_name" | t }}</label>
        <input type="text" id="page-name" name="name" required
              value="{{ page.name }}"
              placeholder="{{ "view_strings.sections_editor.my_awesome_page" | t }}"
              class="truncate w-full border-b border-transparent bg-transparent p-0 !text-[2rem] font-bold text-gray-900 focus:border-indigo-500 focus:outline-none">
              <!-- auto slug -->
              <div>
                <div class="flex min-w-0 flex-wrap items-center gap-1 text-xs font-mono text-gray-500">
                  <span class="shrink-0">/</span>
                  <label for="slug" class="sr-only">{{ "view_strings.sections_editor.slug" | t }}</label>
                  <input type="text" id="slug" name="slug" required
                        value="{{ page.slug }}"
                        placeholder="my-awesome-page"
                        class="min-w-[10rem] flex-1 border-b border-transparent bg-transparent p-0 focus:border-indigo-500 focus:outline-none">
                  <button type="button" id="copy-slug-btn" title="{{ "view_strings.sections_editor.copy_slug" | t }}"
                          class="hidden shrink-0 rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-indigo-700">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#copy"></use></svg>
                    <span class="sr-only">{{ "view_strings.sections_editor.copy_slug" | t }}</span>
                  </button>
                </div>
              </div>

        <div class="mt-2 flex min-w-0 flex-wrap items-center gap-2">
          <div class="inline-flex max-w-full items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
            <label for="page_type" class="sr-only">{{ "view_strings.sections_editor.page_type" | t }}</label>
            <input type="text" id="page_type" name="page_type" list="page_type_options"
                  value="{{ page.pageType }}"
                  placeholder="{{ "view_strings.sections_editor.default" | t }}"
                  class="w-full min-w-0 border-0 bg-transparent p-0 text-sm font-medium text-indigo-700 outline-none focus:border-transparent focus:outline-none focus:ring-0 sm:text-xs">
          </div>
          {% if publicationStatus == 'scheduled' %}
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium bg-blue-100 text-blue-600">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>{{ "pages.status.scheduled" | t }}
            </span>
          {% elsif publicationStatus == 'ended' %}
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-700">
              <span class="h-1.5 w-1.5 rounded-full bg-gray-500"></span>{{ "pages.status.ended" | t }}
            </span>
          {% elsif publicationStatus == 'live' %}
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">
              <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>{{ "pages.status.live" | t }}
            </span>
          {% else %}
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-800">
              <span class="h-1.5 w-1.5 rounded-full bg-yellow-500"></span>{{ "pages.status.draft" | t }}
            </span>
          {% endif %}
          <datalist id="page_type_options">
            {% for option in pageTypeOptions %}
              <option value="{{ option.value }}"></option>
            {% endfor %}
          </datalist>
        </div>
      </div>
      <!-- end page edit header -->
      <div class="w-full md:max-w-[25%] md:border-l md:border-gray-200 md:pl-4">
        <div class="flex items-center justify-between gap-1 text-xs text-gray-600">
          <span class="text-sm text-gray-500">#</span>
          <label for="weight" class="sr-only">{{ "view_strings.sections_editor.sort_weight" | t }}</label>
          <input type="number" id="weight" name="weight"
                 value="{{ page.weight }}" min="0" max="100000"
                 class="w-full border-b border-transparent bg-transparent p-0 text-right text-lg font-bold focus:border-indigo-500 focus:outline-none">
        </div>

        <div>
        <label for="parent_page_search" class="sr-only">{{ "view_strings.sections_editor.parent_page" | t }}</label>
        <div class="w-full relative mb-2 pe-2 flex min-w-0 items-center gap-1" data-parent-combobox data-parent-exclude="{{ page.id }}">
          <svg class="h-3.5 w-3.5 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#folder"></use></svg>
          <input type="hidden" id="page_id" name="page_id" value="{{ selectedParent.id }}">
          <input type="text" id="parent_page_search"
                value="{{ selectedParent.label }}"
                placeholder="{{ "view_strings.sections_editor.no_parent" | t }}"
                autocomplete="off"
                role="combobox"
                aria-controls="parent_page_results"
                aria-expanded="false"
                aria-autocomplete="list"
                class="w-full truncate border-0 bg-transparent p-0 text-xs text-gray-700 focus:outline-none focus:ring-0"
                data-parent-search>
          <button type="button" class="shrink-0 rounded p-0.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700" data-parent-toggle aria-label="{{ "view_strings.sections_editor.search_parent_pages" | t }}">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-down"></use></svg>
          </button>
          <div id="parent_page_results"
              class="absolute right-0 top-6 z-20 hidden w-72 max-w-[calc(100vw-2rem)] overflow-hidden rounded-lg border border-gray-200 bg-white py-1 shadow-lg"
              data-parent-results>
            <button type="button"
                    class="block w-full px-3 py-2 text-left text-xs text-gray-700 hover:bg-gray-50"
                    data-parent-option
                    data-parent-id=""
                    data-parent-label=""
                    data-parent-search="/ none top level">
              <span class="block font-medium">/</span>
              <span class="block text-[11px] text-gray-400">{{ "view_strings.sections_editor.no_parent" | t }}</span>
            </button>
            <p class="hidden px-3 py-2 text-xs text-gray-400" data-parent-empty>{{ "view_strings.sections_editor.no_matching_pages" | t }}</p>
          </div>
        </div>
        </div>

        <div class="relative w-full">

        <div class="rounded-xl border border-gray-200 bg-white px-4 py-1 shadow-sm md:absolute md:left-0 md:right-0">
        <div class="flex items-center justify-between gap-2">
          <button type="button"
                  class="flex w-full items-center justify-between font-bold text-gray-900 text-sm"
                  data-publish-schedule-toggle
                  data-collapse-label="{{ "view_strings.sections_editor.collapse_publish_schedule" | t }}"
                  data-expand-label="{{ "view_strings.sections_editor.expand_publish_schedule" | t }}"
                  aria-controls="publish_schedule_panel"
                  aria-expanded="false"
                  aria-label="{{ "view_strings.sections_editor.expand_publish_schedule" | t }}"
                  title="{{ "view_strings.sections_editor.expand_publish_schedule" | t }}">
            <span>{{ "view_strings.sections_editor.publish_schedule" | t }}</span>
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center text-gray-500">
              <svg class="hidden h-4 w-4" data-publish-schedule-expanded-icon fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-down"></use></svg>
              <svg class="h-4 w-4" data-publish-schedule-collapsed-icon fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-right"></use></svg>
            </span>
          </button>
        </div>
        <div id="publish_schedule_panel" data-publish-schedule-panel class="min-w-0 flex-1 mt-2" hidden>
          <label for="start" class="flex min-w-0 items-center gap-2">
            <span class="shrink-0 text-xs text-gray-500">{{ "view_strings.sections_editor.from" | t }}</span>
            <input type="datetime-local" id="start" name="start"
                  value="{{ page.start }}"
                  class="min-w-0 flex-1 border-b border-transparent bg-transparent p-0 text-xs text-gray-900 focus:border-indigo-500 focus:outline-none">
          </label>
          <label for="end" class="flex min-w-0 items-center gap-2">
            <span class="shrink-0 text-xs text-gray-500">{{ "view_strings.sections_editor.until" | t }}</span>
            <input type="datetime-local" id="end" name="end"
                  value="{{ page.end }}"
                  class="min-w-0 flex-1 border-b border-transparent bg-transparent p-0 text-xs text-gray-900 focus:border-indigo-500 focus:outline-none">
          </label>
          <label for="timezone" class="flex min-w-0 items-center gap-2 sm:col-span-2">
            <span class="shrink-0 text-xs text-gray-500">{{ "view_strings.sections_editor.timezone" | t }}</span>
            <input type="text" id="timezone" name="timezone"
                  value="{{ page.timezone }}"
                  placeholder="+0800"
                  class="min-w-0 flex-1 border-b border-transparent bg-transparent p-0 text-xs text-gray-900 focus:border-indigo-500 focus:outline-none">
          </label>
        {% unless isVersionPreview %}
          {% if isEdit %}
            {% unless isPublished %}
            <button type="submit" name="action" value="publish"
                    class="mt-4 w-full px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition-colors shadow-sm">{{ "view_strings.sections_editor.publish" | t }}</button>
            {% endunless %}
            {% if isPublished and isLiveSynced == false %}
            <button type="submit" name="action" value="publish"
                    class="mt-4 w-full px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition-colors shadow-sm">{{ "view_strings.sections_editor.re_publish" | t }}</button>
            {% endif %}
            {% if isPublished %}
            <button type="submit" formaction="{{ unpublishAction }}" formnovalidate data-unpublish-button data-confirm-message="{{ "view_strings.sections_editor.unpublish_page_confirm" | t }}"
                    class="mt-4 w-full px-4 py-2 bg-yellow-600 text-white text-sm font-semibold rounded-lg hover:bg-yellow-700 transition-colors shadow-sm">{{ "view_strings.sections_editor.un_publish" | t }}</button>
            {% endif %}
          {% endif %}
        {% endunless %}
        </div>
        <!-- end publish schedule panel -->
        </div>

        </div>
      </div>
    </div>

    <div class="flex flex-col xl:flex-row xl:gap-4">
      <div class="w-full">
    {{ structuredBlock | raw }}
      </div>

    <div class="w-full xl:max-w-[25%]">
    <div class="grid grid-col gap-4 mt-4 xl:mt-0">
    {% if hasPreservedTagIds %}
      {% for tagId in preservedTagIds %}
        <input type="hidden" name="tag_ids" value="{{ tagId }}">
      {% endfor %}
    {% endif %}

    {% if hasTagGroups %}
      <div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <p class="mb-3 flex items-center gap-2 text-sm font-medium text-gray-700">
          <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#tag"></use></svg>
          <span>{{ "view_strings.sections_editor.tags" | t }}</span>
        </p>
        <div class="space-y-4">
          {% for group in tagGroups %}
            <div class="min-w-0 space-y-2">
              <p class="min-w-0 break-words text-xs font-semibold uppercase tracking-wide text-gray-400">{{ group.name }}</p>
              {% if group.hasTags %}
                <label for="tags_search_{{ group.slug }}" class="sr-only">{{ "view_strings.sections_editor.search_tags" | t }}</label>
                <div class="relative flex min-w-0 flex-wrap items-center gap-1.5" data-tags-combobox>
                  {% for tag in group.tags %}
                    {% if tag.checked %}
                      <span class="inline-flex max-w-full items-center gap-1 rounded bg-indigo-100 py-0.5 pl-2 pr-1 text-xs font-medium text-indigo-700" data-tag-chip data-tag-id="{{ tag.id }}">
                        <input type="hidden" name="tag_ids" value="{{ tag.id }}">
                        <span class="truncate">{{ tag.name }}</span>
                        <button type="button" class="shrink-0 rounded p-0.5 text-indigo-400 hover:bg-indigo-200 hover:text-indigo-700" data-tag-remove aria-label="{{ "view_strings.sections_editor.remove_tag" | t }}">
                          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                        </button>
                      </span>
                    {% endif %}
                  {% endfor %}
                  <input type="text" id="tags_search_{{ group.slug }}"
                         placeholder="{{ "view_strings.sections_editor.search_tags" | t }}"
                         autocomplete="off"
                         role="combobox"
                         aria-expanded="false"
                         aria-autocomplete="list"
                         aria-controls="tags_results_{{ group.slug }}"
                         class="min-w-[9rem] flex-1 border-b border-transparent bg-transparent p-0 text-xs text-gray-600 focus:border-indigo-500 focus:outline-none"
                         data-tags-search>
                  <div id="tags_results_{{ group.slug }}"
                       class="absolute left-0 top-full z-20 mt-1 hidden max-h-56 w-72 max-w-[calc(100vw-2rem)] overflow-y-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg"
                       data-tags-results>
                    {% for tag in group.tags %}
                      <button type="button"
                              class="block w-full truncate px-3 py-2 text-left text-xs text-gray-700 hover:bg-gray-50{% if tag.checked %} hidden{% endif %}"
                              data-tag-option
                              data-tag-id="{{ tag.id }}"
                              data-tag-name="{{ tag.name }}">{{ tag.name }}</button>
                    {% endfor %}
                    <p class="hidden px-3 py-2 text-xs text-gray-400" data-tags-empty>{{ "view_strings.sections_editor.no_matching_tags" | t }}</p>
                  </div>
                  <template data-tag-chip-template>
                    <span class="inline-flex max-w-full items-center gap-1 rounded bg-indigo-100 py-0.5 pl-2 pr-1 text-xs font-medium text-indigo-700" data-tag-chip>
                      <input type="hidden" name="tag_ids" value="">
                      <span class="truncate"></span>
                      <button type="button" class="shrink-0 rounded p-0.5 text-indigo-400 hover:bg-indigo-200 hover:text-indigo-700" data-tag-remove aria-label="{{ "view_strings.sections_editor.remove_tag" | t }}">
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                      </button>
                    </span>
                  </template>
                </div>
              {% else %}
                <a href="/admin/tags/new" class="text-xs text-indigo-600 hover:text-indigo-500">{{ "view_strings.sections_editor.no_tags_in_taxonomy" | t }}</a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if hasVersions %}
      <div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <div class="mb-3 flex min-w-0 items-center justify-between gap-3">
          <p class="flex items-center gap-2 text-sm font-semibold text-gray-700">
            <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#clock"></use></svg>
            <span>{{ "view_strings.sections_editor.versions" | t }}</span>
          </p>
          <button type="submit" name="action" value="delete-versions" formnovalidate data-clean-versions-button data-confirm-message="{{ "view_strings.sections_editor.clean_versions_confirm" | t }}" title="{{ "view_strings.sections_editor.clean_all_versions_2" | t }}" aria-label="{{ "view_strings.sections_editor.clean_all_versions_2" | t }}"
                  class="inline-flex h-10 shrink-0 items-center justify-center rounded-lg border border-red-200 bg-white px-3 text-xs font-semibold text-red-700 hover:bg-red-50">
            {{ "view_strings.sections_editor.clean_all_versions" | t }}
          </button>
        </div>
        <div class="space-y-2">
          {% for version in versions %}
            <div class="flex min-w-0 items-start gap-2">
              <a href="{{ version.href }}"
                 class="flex min-h-10 min-w-0 flex-1 items-center break-words rounded-lg border px-3 py-1.5 text-xs {% if version.active %}border-amber-400 bg-amber-50 text-amber-800{% else %}border-gray-300 bg-white text-gray-700 hover:bg-gray-50{% endif %}">
                <span>{{ version.createdAt | l10n_date }}</span>
                {% if version.description %}
                  <span class="text-gray-500"> - {{ version.description }}</span>
                {% endif %}
                {% if version.live %}
                  <span class="ml-1 rounded bg-green-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-green-700">{{ "view_strings.sections_editor.live" | t }}</span>
                {% endif %}
              </a>
              <button type="submit" name="action" value="{{ version.removeAction }}" formnovalidate data-version-delete-button data-confirm-message="{{ "view_strings.sections_editor.remove_version_confirm" | t }}" title="{{ "view_strings.sections_editor.remove_version" | t }}" aria-label="{{ "view_strings.sections_editor.remove_version" | t }}"
                      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-red-200 bg-white p-0 text-red-700 hover:bg-red-50">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                <span class="sr-only">{{ "view_strings.sections_editor.remove_version" | t }}</span>
              </button>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
      </div>
    </div>
    </div>

    <details id="lect_json_details" class="group min-w-0 border-t border-gray-200 mb-0">
      <summary class="flex cursor-pointer list-none items-center gap-2 py-3 px-0 text-xs font-medium text-gray-500 [&::-webkit-details-marker]:hidden">
        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-right"></use></svg>
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#code"></use></svg>
        <span>{{ "view_strings.sections_editor.lect_json" | t }}</span>
        <span class="text-gray-400">{{ "view_strings.sections_editor.raw_metadata" | t }}</span>
      </summary>
      <div class="flex min-w-0 flex-col gap-2 px-4 pb-3 sm:px-5">
        {% if hasLectDiff %}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-gray-400">
            <span>{{ "view_strings.sections_editor.diff_vs_current_draft" | t }}</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-sm bg-emerald-200"></span> {{ "view_strings.sections_editor.this_version" | t }}</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-sm bg-rose-200"></span> {{ "view_strings.sections_editor.current_draft" | t }}</span>
          </div>
          <pre class="block min-w-0 w-full max-w-full overflow-x-auto rounded border border-gray-300 bg-gray-50 p-3 text-[11px] leading-5 font-mono text-gray-800">{{ lectDiffHtml | raw }}</pre>
        {% else %}
          <label for="lect_json" class="sr-only">{{ "view_strings.sections_editor.lect_json" | t }}</label>
          <textarea id="lect_json" name="lect_json" rows="4"
                    class="block min-w-0 w-full max-w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-xs font-mono text-gray-800 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-y">{{ page.lect }}</textarea>
        {% endif %}
      </div>
    </details>

    <div class="flex min-w-0 flex-col gap-3 border-t border-gray-200 pt-3 sm:flex-row sm:items-center sm:justify-between">
      {% if page.hasCreator or page.hasModifier %}
        <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2">
          {% if page.hasCreator %}
          <div class="flex min-w-0 items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#edit-square"></use></svg>
            <span class="text-xs text-gray-500">{{ "view_strings.sections_editor.created_by" | t }}</span>
            <span class="min-w-0 truncate text-xs font-medium text-gray-700">{{ page.creatorName }}</span>
          </div>
          {% endif %}
          {% if page.hasModifier %}
          <div class="flex min-w-0 items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#edit-square"></use></svg>
            <span class="text-xs text-gray-500">{{ "view_strings.sections_editor.last_modified_by" | t }}</span>
            <span class="min-w-0 truncate text-xs font-medium text-gray-700">{{ page.modifierName }}</span>
          </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="flex min-w-0 flex-1 items-center gap-2 sm:max-w-xl">
        <div class="flex shrink-0 items-center gap-2 text-gray-500">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#user-group"></use></svg>
          <label for="editors_search" class="sr-only">{{ "view_strings.sections_editor.editors" | t }}</label>
        </div>
        <div class="relative flex min-w-0 flex-1 flex-wrap items-center gap-1.5" data-editors-combobox>
          <input type="hidden" id="editors" name="editors" value="{{ page.editors }}">
          {% for editor in page.editorChips %}
            <span class="inline-flex max-w-full items-center gap-1 rounded bg-blue-100 py-0.5 pl-2 pr-1 text-xs font-medium text-blue-700" data-editor-chip data-editor-id="{{ editor.id }}">
              <span class="truncate">{{ editor.name }}</span>
              <button type="button" class="shrink-0 rounded p-0.5 text-blue-400 hover:bg-blue-200 hover:text-blue-700" data-editor-remove aria-label="{{ "view_strings.sections_editor.remove_editor" | t }}">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
              </button>
            </span>
          {% endfor %}
          <input type="text" id="editors_search"
                 placeholder="{{ "view_strings.sections_editor.search_users" | t }}"
                 autocomplete="off"
                 role="combobox"
                 aria-expanded="false"
                 aria-autocomplete="list"
                 aria-controls="editors_results"
                 class="min-w-[9rem] flex-1 border-b border-transparent bg-transparent p-0 text-xs text-gray-600 focus:border-indigo-500 focus:outline-none"
                 data-editors-search>
          <div id="editors_results"
               class="absolute left-0 top-full z-20 mt-1 hidden w-72 max-w-[calc(100vw-2rem)] overflow-hidden rounded-lg border border-gray-200 bg-white py-1 shadow-lg"
               data-editors-results>
            <p class="hidden px-3 py-2 text-xs text-gray-400" data-editors-empty>{{ "view_strings.sections_editor.no_matching_users" | t }}</p>
          </div>
          <template data-editor-chip-template>
            <span class="inline-flex max-w-full items-center gap-1 rounded bg-blue-100 py-0.5 pl-2 pr-1 text-xs font-medium text-blue-700" data-editor-chip>
              <span class="truncate"></span>
              <button type="button" class="shrink-0 rounded p-0.5 text-blue-400 hover:bg-blue-200 hover:text-blue-700" data-editor-remove aria-label="{{ "view_strings.sections_editor.remove_editor" | t }}">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
              </button>
            </span>
          </template>
        </div>
      </div>

    {% if structuredModel %}
    <div class="flex min-w-0 flex-col gap-2 sm:shrink-0"
         data-fields-clipboard
         data-copy-manual="{{ "view_strings.snippets_structured_editor.copy_manual" | t }}"
         data-paste-manual="{{ "view_strings.snippets_structured_editor.paste_manual" | t }}"
         data-copied-status="{{ "view_strings.snippets_structured_editor.copied_status" | t }}"
         data-pasted-status="{{ "view_strings.snippets_structured_editor.pasted_status" | t }}"
         data-paste-confirm="{{ "view_strings.snippets_structured_editor.paste_confirm" | t }}"
         data-paste-invalid="{{ "view_strings.snippets_structured_editor.paste_invalid" | t }}"
         data-nothing-to-copy="{{ "view_strings.snippets_structured_editor.nothing_to_copy" | t }}">
      <div class="flex min-w-0 flex-wrap items-center justify-end gap-2">
        <button type="button" data-fields-copy
                title="{{ "view_strings.snippets_structured_editor.copy_fields_hint" | t }}"
                class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#copy"></use></svg>
          {{ "view_strings.snippets_structured_editor.copy_fields" | t }}
        </button>
        {%- comment -%}Hidden until something copied is available to paste — the editor script reveals it.{%- endcomment -%}
        <button type="button" data-fields-paste
                title="{{ "view_strings.snippets_structured_editor.paste_fields_hint" | t }}"
                class="hidden shrink-0 items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#paste"></use></svg>
          {{ "view_strings.snippets_structured_editor.paste_fields" | t }}
        </button>
      </div>
      <div data-fields-clipboard-panel class="hidden min-w-0 space-y-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
        <p class="text-xs text-gray-500" data-fields-panel-hint></p>
        <label for="fields_clipboard_text" class="sr-only">{{ "view_strings.snippets_structured_editor.copy_fields" | t }}</label>
        <textarea id="fields_clipboard_text" rows="4" spellcheck="false" data-fields-clipboard-text
                  class="block min-w-0 w-full max-w-full rounded border border-gray-300 bg-white px-3 py-2 text-xs font-mono text-gray-800 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-y"></textarea>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-fields-panel-apply
                  class="hidden shrink-0 rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-semibold text-white">{{ "view_strings.snippets_structured_editor.apply" | t }}</button>
          <button type="button" data-fields-panel-close
                  class="shrink-0 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.snippets_structured_editor.close" | t }}</button>
        </div>
      </div>
      <p data-fields-status role="status" class="hidden text-xs text-gray-500"></p>
    </div>
    {% endif %}
    </div>

    {% if isEdit %}
    <div class="pb-8 absolute right-8">
      <button type="submit" formaction="{{ deleteAction }}" formnovalidate data-delete-button data-confirm-message="{{ "view_strings.sections_editor.delete_page_confirm" | t }}" title="{{ "view_strings.sections_editor.delete" | t }}" aria-label="{{ "view_strings.sections_editor.delete" | t }}"
              class="inline-flex h-10 w-10 shrink-0 self-end items-center justify-center rounded-lg bg-red-600 text-white shadow-sm transition-colors hover:bg-red-700 sm:ml-auto">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash"></use></svg>
        <span class="sr-only">{{ "view_strings.sections_editor.delete" | t }}</span>
      </button>
    </div>
    {% endif %}

    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sticky bottom-4">
      {% if isVersionPreview %}
        <button type="submit" name="action" value="{{ selectedVersion.restoreAction }}"
                class="w-full px-6 py-2 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors shadow-sm sm:w-auto">
          {{ "view_strings.sections_editor.restore_version" | t }}
        </button>
        <a href="{{ selectedVersion.currentHref }}" class="w-full px-6 py-2 text-center bg-white text-gray-700 text-sm font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors sm:w-auto">
          {{ "view_strings.sections_editor.edit_current" | t }}
        </a>
      {% else %}
        <button type="submit"
                class="w-full px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors shadow-sm sm:w-auto">
          {% if isEdit %}{{ "view_strings.sections_editor.save_changes" | t }}{% else %}{{ "view_strings.sections_editor.create_page" | t }}{% endif %}
        </button>
        {% if isEdit and isPublished %}
          <button type="submit" name="action" value="publish"
                  class="w-full px-6 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition-colors shadow-sm sm:w-auto">
            {{ "view_strings.sections_editor.save_and_publish" | t }}
          </button>
        {% endif %}
      {% endif %}
      <a href="{{ backHref }}" class="w-full px-6 py-2 text-center bg-white text-gray-700 text-sm font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors sm:w-auto">
        {{ "view_strings.sections_editor.cancel" | t }}
      </a>
    </div>
  </form>
</div>
