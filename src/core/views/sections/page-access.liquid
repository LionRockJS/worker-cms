<div class="min-w-0 max-w-2xl my-4 space-y-6 px-4 sm:px-6 lg:px-8">
  <form method="post" action="{{ action }}" class="min-w-0 space-y-4 bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
    <input type="hidden" name="revision" value="{{ revision }}">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <p class="min-w-0 text-sm text-gray-500">{{ "page_access.owner" | t }} <span class="font-semibold text-gray-900">{{ owner }}</span></p>
      {% if enabled %}<span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-700">{{ mode }}</span>{% endif %}
    </div>
    {% unless enabled %}
      <div class="px-4 py-2 rounded-lg bg-amber-50 text-amber-800 text-sm">{{ "page_access.legacy" | t }}</div>
    {% endunless %}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {% for permission in permissions %}
        {% assign labelKey = "page_access." | append: permission.key %}
        <label class="block min-w-0">
          <span class="block text-sm font-medium text-gray-700 mb-1">{{ labelKey | t }}</span>
          <select class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white" name="{{ permission.key }}">
            <option value="0"{% if permission.digit == "0" %} selected{% endif %}>{{ "page_access.none" | t }}</option>
            <option value="4"{% if permission.digit == "4" %} selected{% endif %}>{{ "page_access.read" | t }}</option>
            <option value="6"{% if permission.digit == "6" %} selected{% endif %}>{{ "page_access.edit" | t }}</option>
          </select>
        </label>
      {% endfor %}
      <label class="block min-w-0">
        <span class="block text-sm font-medium text-gray-700 mb-1">{{ "page_access.role" | t }}</span>
        <select class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white" name="group_role">
          <option value="">{{ "page_access.no_group" | t }}</option>
          {% for role in roles %}<option{% if group == role %} selected{% endif %}>{{ role }}</option>{% endfor %}
        </select>
      </label>
    </div>
    {% if enabled == false and legacyEditors.size > 0 %}
      <fieldset class="min-w-0">
        <legend class="block text-sm font-medium text-gray-700 mb-1">{{ "page_access.review" | t }}</legend>
        <div class="flex flex-wrap gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
          {% for user in legacyEditors %}
            <label class="inline-flex items-center gap-2 rounded-md bg-white border border-gray-200 px-3 py-1.5 text-sm">
              <input type="checkbox" name="legacy_user" value="{{ user.id }}" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
              <span>{{ user.name }}</span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
    {% endif %}
    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center">
      <button
              class="inline-flex px-6 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors shadow-sm items-center justify-center shrink-0 gap-2 h-10" name="action" value="mode"
              title="{% if enabled %}{{ "page_access.save" | t }}{% else %}{{ "page_access.enable" | t }}{% endif %}"
              aria-label="{% if enabled %}{{ "page_access.save" | t }}{% else %}{{ "page_access.enable" | t }}{% endif %}">
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#{% if enabled %}save{% else %}lock-closed{% endif %}"></use></svg>
        <span class="hidden lg:inline">{% if enabled %}{{ "page_access.save" | t }}{% else %}{{ "page_access.enable" | t }}{% endif %}</span>
      </button>
    </div>
  </form>

  {% if enabled %}
    <section class="min-w-0 bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
      <h3 class="text-lg font-bold text-gray-900">{{ "page_access.sharing" | t }}</h3>
      {% if grants.size > 0 %}
        <ul class="mt-3 divide-y divide-gray-100">
          {% for user in grants %}
            <li>
              <form method="post" action="{{ action }}" class="flex items-center justify-between gap-3 py-2">
                <input type="hidden" name="revision" value="{{ revision }}">
                <input type="hidden" name="user_id" value="{{ user.id }}">
                <span class="min-w-0 truncate text-sm text-gray-900">{{ user.name }}</span>
                <button
                        class="inline-flex shrink-0 text-sm font-semibold text-red-600 hover:text-red-700 items-center justify-center gap-2 h-8 min-w-8" name="action" value="remove"
                        title="{{ "page_access.remove" | t }}"
                        aria-label="{{ "page_access.remove" | t }}">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                  <span class="hidden lg:inline">{{ "page_access.remove" | t }}</span>
                </button>
              </form>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endif %}

  <section class="min-w-0 bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
    <form method="post" action="{{ action }}" class="min-w-0 space-y-3" data-access-user-form>
      <input type="hidden" name="revision" value="{{ revision }}">
      <input type="hidden" name="user_id" value="" data-access-user-id>
      <label for="page-access-user" class="block text-sm font-medium text-gray-700 mb-1">{{ "page_access.search_users" | t }}</label>
      <div class="relative min-w-0" data-access-user-picker data-source="/admin/api/users" data-empty-text="{{ "page_access.no_matching_users" | t }}">
        <input id="page-access-user" type="text" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="page-access-user-results"
               placeholder="{{ "page_access.choose_user" | t }}"
               class="block w-full min-w-0 px-3 py-2 pr-9 border border-gray-300 rounded-lg text-sm" data-access-user-search>
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#search"></use></svg>
        </span>
        <div id="page-access-user-results" role="listbox" class="absolute left-0 top-full z-20 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg" data-access-user-results></div>
      </div>
      <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center">
        {% if enabled %}<button
                class="inline-flex px-6 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors shadow-sm disabled:cursor-not-allowed disabled:opacity-50 items-center justify-center shrink-0 gap-2 h-10" name="action" value="add" disabled data-access-user-action
                title="{{ "page_access.add" | t }}"
                aria-label="{{ "page_access.add" | t }}">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#plus"></use></svg>
          <span class="hidden lg:inline">{{ "page_access.add" | t }}</span>
        </button>{% endif %}
        <button
                class="inline-flex px-6 text-center bg-white text-gray-700 text-sm font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors disabled:cursor-not-allowed disabled:opacity-50 items-center justify-center shrink-0 gap-2 h-10" name="action" value="transfer" disabled data-access-user-action
                title="{{ "page_access.transfer" | t }}"
                aria-label="{{ "page_access.transfer" | t }}">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#key"></use></svg>
          <span class="hidden lg:inline">{{ "page_access.transfer" | t }}</span>
        </button>
      </div>
    </form>
  </section>
</div>

<script nonce="{{ nonce }}">
(function () {
  var picker = document.querySelector('[data-access-user-picker]');
  if (!picker || picker.dataset.bound) return;
  picker.dataset.bound = '1';
  var form = picker.closest('form');
  var hidden = form.querySelector('[data-access-user-id]');
  var search = picker.querySelector('[data-access-user-search]');
  var results = picker.querySelector('[data-access-user-results]');
  var actions = form.querySelectorAll('[data-access-user-action]');
  var timer, requestId = 0, chosenLabel = '', active = -1;

  function options() { return Array.prototype.slice.call(results.querySelectorAll('[role="option"]')); }
  function setChosen(id, label) {
    hidden.value = id; chosenLabel = label;
    actions.forEach(function (button) { button.disabled = !id; });
  }
  function close() { results.classList.add('hidden'); search.setAttribute('aria-expanded', 'false'); active = -1; }
  function open() { results.classList.remove('hidden'); search.setAttribute('aria-expanded', 'true'); }
  function highlight(index) {
    var list = options();
    if (!list.length) return;
    active = (index + list.length) % list.length;
    list.forEach(function (option, i) {
      option.classList.toggle('bg-gray-100', i === active);
      option.setAttribute('aria-selected', i === active ? 'true' : 'false');
    });
    list[active].scrollIntoView({ block: 'nearest' });
  }
  function choose(user) {
    var label = user.email && user.email !== user.name ? user.name + ' (' + user.email + ')' : user.name;
    search.value = label;
    setChosen(String(user.id), label);
    close();
  }
  function render(users) {
    results.textContent = '';
    active = -1;
    if (!users.length) {
      var empty = document.createElement('p');
      empty.className = 'px-3 py-2 text-sm text-gray-400';
      empty.textContent = picker.getAttribute('data-empty-text') || '';
      results.appendChild(empty);
    }
    users.forEach(function (user) {
      var option = document.createElement('button');
      option.type = 'button';
      option.setAttribute('role', 'option');
      option.className = 'block w-full px-3 py-2 text-left text-sm text-gray-700 hover:bg-gray-50';
      var name = document.createElement('span');
      name.className = 'block truncate font-medium';
      name.textContent = user.name;
      option.appendChild(name);
      if (user.email && user.email !== user.name) {
        var email = document.createElement('span');
        email.className = 'block truncate text-xs text-gray-400';
        email.textContent = user.email;
        option.appendChild(email);
      }
      // mousedown (not click) runs before the input's blur closes the list.
      option.addEventListener('mousedown', function (event) { event.preventDefault(); choose(user); });
      results.appendChild(option);
    });
    open();
  }
  function load() {
    clearTimeout(timer);
    timer = setTimeout(function () {
      var id = ++requestId;
      fetch(picker.getAttribute('data-source') + '?q=' + encodeURIComponent(search.value.trim()), { headers: { accept: 'application/json' } })
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(function (users) { if (id === requestId && Array.isArray(users)) render(users); })
        .catch(function () {});
    }, 180);
  }

  search.addEventListener('focus', load);
  search.addEventListener('input', function () {
    if (search.value !== chosenLabel) setChosen('', '');
    load();
  });
  search.addEventListener('keydown', function (event) {
    if (event.key === 'ArrowDown') { event.preventDefault(); if (results.classList.contains('hidden')) load(); else highlight(active + 1); }
    else if (event.key === 'ArrowUp') { event.preventDefault(); highlight(active - 1); }
    else if (event.key === 'Escape') { close(); }
    else if (event.key === 'Enter') {
      event.preventDefault();
      var list = options();
      var pick = list[active >= 0 ? active : 0];
      if (pick && !results.classList.contains('hidden')) pick.dispatchEvent(new MouseEvent('mousedown', { cancelable: true }));
    }
  });
  search.addEventListener('blur', function () { setTimeout(close, 150); });
  document.addEventListener('click', function (event) { if (!picker.contains(event.target)) close(); });
})();
</script>
