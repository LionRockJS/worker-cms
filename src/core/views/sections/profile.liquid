<div class="px-4 pb-5 pt-1 sm:px-6 sm:pb-8 lg:px-8">

  <section class="mb-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <form method="post" action="{{ uiLocaleAction }}" class="flex min-w-0 flex-1 flex-col gap-3 sm:flex-row sm:items-end">
        <label class="min-w-0 flex-1 text-sm font-medium text-gray-700">{{ "profile.interface_language" | t }}
          <select name="locale" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2">
            {% for option in uiLocaleOptions %}<option value="{{ option.code }}" {% if option.selected %}selected{% endif %}>{{ option.label }}</option>{% endfor %}
          </select>
        </label>
        <button type="submit" class="h-10 shrink-0 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white">{{ "profile.save_language" | t }}</button>
      </form>

      <div class="flex flex-wrap items-center gap-2">
        <button type="button"
                class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 hover:bg-gray-50"
                data-theme-toggle
                data-theme-light-label="{{ "shell.theme.light" | t }}"
                data-theme-dark-label="{{ "shell.theme.dark" | t }}"
                data-theme-switch-light="{{ "shell.theme.switch_to_light" | t }}"
                data-theme-switch-dark="{{ "shell.theme.switch_to_dark" | t }}"
                aria-pressed="false"
                aria-label="{{ "shell.theme.switch_to_light" | t }}">
          <svg class="h-4 w-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-theme-icon="light"><use href="{{ iconHrefPrefix }}#sun"></use></svg>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-theme-icon="dark"><use href="{{ iconHrefPrefix }}#moon"></use></svg>
          <span data-theme-toggle-label>{{ "shell.theme.dark" | t }}</span>
        </button>

        <form method="post" action="/auth/logout" class="inline-flex">
          <button type="submit"
                  class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-red-200 bg-white px-3 text-sm font-semibold text-red-700 hover:bg-red-50"
                  aria-label="{{ "shell.sign_out" | t }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#logout"></use></svg>
            {{ "shell.sign_out" | t }}
          </button>
        </form>
      </div>
    </div>
  </section>

  {% if hasFlash %}
    <div data-profile-alert class="mb-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-700">{{ flash | t }}</div>
  {% endif %}
  {% if hasError %}
    <div data-profile-alert class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{{ error | t }}</div>
  {% endif %}

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
      <div class="flex min-w-0 items-center gap-4">
        {% if hasAvatar %}
          <img src="{{ avatarUrl }}"
               class="h-16 w-16 shrink-0 rounded-full object-cover"
               alt="{{ "profile.avatar" | t }}"
               data-avatar-img>
        {% else %}
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-2xl font-bold text-white">{{ initial }}</div>
        {% endif %}
        <div class="min-w-0">
          <h3 class="truncate text-xl font-semibold text-gray-900">{{ name }}</h3>
          <p class="truncate text-sm text-gray-500">{{ email }}</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500">{{ roleLabel }}</p>
        </div>
      </div>
      <form method="post" action="/admin/profile/avatar" class="mt-4 flex flex-wrap items-center gap-2" data-avatar-form data-avatar-name="{{ name }}">
        <input type="hidden" name="avatar" value="">
        <input type="file" accept="image/*" class="hidden" data-avatar-file>
        <button type="button" data-avatar-upload
                class="inline-flex h-9 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "profile.avatar_upload" | t }}</button>
        <button type="button" data-avatar-initials
                class="inline-flex h-9 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "profile.avatar_initials" | t }}</button>
        {% if hasOwnAvatar %}
          <button type="submit"
                  class="inline-flex h-9 items-center justify-center rounded-lg border border-red-200 bg-white px-3 text-xs font-semibold text-red-700 hover:bg-red-50">{{ "profile.avatar_remove" | t }}</button>
        {% endif %}
        <p class="hidden w-full text-xs text-red-700" data-avatar-error>{{ "profile.invalid_avatar" | t }}</p>
      </form>
      <form method="post" action="/admin/profile" class="mt-5 space-y-3 border-t border-gray-100 pt-5">
        <label for="profile-name" class="block text-sm font-medium text-gray-700">{{ "profile.display_name" | t }}</label>
        <input id="profile-name" name="name" type="text" required maxlength="100" autocomplete="name" value="{{ name }}"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
        <button type="submit" class="h-10 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">{{ "common.save" | t }}</button>
      </form>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500">{{ "profile.connected_identities" | t }}</h3>
      <div class="mt-4 space-y-2">
        {% if hasIdentities %}
          {% for identity in identities %}
            <div class="flex min-w-0 items-center justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900">{{ identity.label }}</p>
                <p class="truncate text-xs text-gray-500">{{ identity.providerUserId }}</p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">{{ "common.connected" | t }}</span>
                {% if identity.canDisconnect %}
                  <form method="post"
                        action="{{ identity.disconnectHref }}"
                        data-confirm="{{ "profile.disconnect_confirm" | t }}">
                    <button type="submit"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 hover:bg-red-50"
                            aria-label="{{ "profile.disconnect" | t }} {{ identity.label }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash"></use></svg>
                    </button>
                  </form>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <p class="text-sm text-gray-500">{{ "profile.no_identities" | t }}</p>
        {% endif %}
      </div>
    </section>
  </div>

  <section class="mt-4 bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-6">
    <div class="mb-4">
      <h3 class="text-lg font-semibold text-gray-900">{{ "profile.sign_in_methods" | t }}</h3>
      <p data-explanation class="mt-1 text-sm text-gray-500">{{ "profile.sign_in_description" | t }}</p>
    </div>
    {% if hasProviders %}
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {% for provider in providers %}
          {% if provider.connected %}
            <div class="flex h-10 items-center justify-between rounded-lg border border-gray-200 bg-gray-50 px-3 text-sm">
              <span class="font-medium text-gray-900">{{ provider.label }}</span>
              <span class="text-xs font-semibold text-green-700">{{ "common.connected" | t }}</span>
            </div>
          {% else %}
            <a href="{{ provider.connectHref }}"
               class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-3 text-sm font-semibold text-gray-700 hover:bg-gray-50">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#plus"></use></svg>
              {{ "profile.connect" | t }} {{ provider.label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-sm text-gray-500">{{ "profile.no_oauth_providers" | t }}</p>
    {% endif %}
  </section>

  {% feature_fragment credits/profile-wallets %}
  <section class="mt-4 rounded-xl border border-red-200 bg-white p-5 shadow-sm sm:p-6">
    <h3 class="text-lg font-semibold text-gray-900">{{ "profile.disable_account" | t }}</h3>
    <p class="mt-2 text-sm text-gray-500">{{ "profile.disable_description" | t }}</p>
    <form method="post" action="/admin/profile/disable" class="mt-4" data-confirm="{{ "profile.disable_confirm" | t }}">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="confirm" value="disable" required>
        {{ "profile.disable_acknowledge" | t }}
      </label>
      <button type="submit" class="mt-3 h-10 rounded-lg border border-red-200 bg-white px-4 text-sm font-semibold text-red-700 hover:bg-red-50">{{ "profile.disable_account" | t }}</button>
    </form>
  </section>
</div>

<script nonce="{{ nonce }}">
  document.querySelectorAll('[data-profile-alert]').forEach((alert) => {
    setTimeout(() => alert.remove(), 4000);
  });

  // The picture is resized in the browser and stored inline, so it needs no
  // media bucket: both buttons end in the same small data URI.
  (() => {
    const form = document.querySelector('[data-avatar-form]');
    if (!form) return;
    const SIZE = 128;
    const field = form.querySelector('[name="avatar"]');
    const file = form.querySelector('[data-avatar-file]');
    const error = form.querySelector('[data-avatar-error]');
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = SIZE;
    const ctx = canvas.getContext('2d');
    const save = (type) => {
      field.value = canvas.toDataURL(type, 0.85);
      form.requestSubmit();
    };

    form.querySelector('[data-avatar-upload]').addEventListener('click', () => file.click());
    file.addEventListener('change', async () => {
      if (!file.files[0]) return;
      try {
        const image = await createImageBitmap(file.files[0]);
        const side = Math.min(image.width, image.height);
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, SIZE, SIZE);
        ctx.drawImage(image, (image.width - side) / 2, (image.height - side) / 2, side, side, 0, 0, SIZE, SIZE);
        save('image/jpeg');
      } catch {
        error.classList.remove('hidden');
      }
      file.value = '';
    });

    form.querySelector('[data-avatar-initials]').addEventListener('click', () => {
      const name = form.dataset.avatarName.trim();
      const words = name.split(/\s+/).filter(Boolean);
      const letters = words.length > 1 ? [words[0], words[words.length - 1]] : words;
      const initials = letters.map((word) => Array.from(word)[0]).join('').toUpperCase() || '?';
      let hue = 0;
      for (const char of name) hue = (hue * 31 + char.codePointAt(0)) % 360;
      ctx.fillStyle = `hsl(${hue}, 55%, 42%)`;
      ctx.fillRect(0, 0, SIZE, SIZE);
      ctx.fillStyle = '#fff';
      ctx.font = `600 ${initials.length > 1 ? 52 : 64}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(initials, SIZE / 2, SIZE / 2 + 4);
      save('image/png');
    });
  })();
</script>
