<div class="min-w-0 px-4 pb-5 sm:px-6 sm:pb-8 lg:px-8">
  {% comment %}Liquid treats "" as truthy, so both banners showed on a plain visit.{% endcomment %}
  {% if syncedCount != blank %}
    <div class="mb-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm text-green-700">{{ "view_strings.sections_tags.synced_tags" | t }} {{ syncedCount }}</div>
  {% endif %}
  {% if syncError != blank %}
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{{ "view_strings.sections_tags.sync_failed" | t }} {{ syncError }}</div>
  {% endif %}
  <div class="mb-4 flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <form method="GET" action="/admin/tags" class="flex min-w-0 flex-1 flex-col gap-2 sm:flex-row sm:items-center">
      <label for="filter_taxonomy" class="sr-only">{{ "view_strings.sections_tags.filter_by_taxonomy" | t }}</label>
      <select id="filter_taxonomy" name="filter_taxonomy" class="min-w-0 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm sm:w-auto">
        <option value="">{{ "view_strings.sections_tags.all_taxonomies" | t }}</option>
        {% for option in filterOptions %}
          <option value="{{ option.id }}" {% if option.selected %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
      <div class="flex min-w-0 flex-1 items-center gap-2">
        <label for="tag_search" class="sr-only">{{ "view_strings.sections_tags.search_tags" | t }}</label>
        <input id="tag_search" type="search" name="search" value="{{ search }}" placeholder="{{ "view_strings.sections_tags.search_tags" | t }}"
               class="h-10 min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-700 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <button type="submit"
                title="{{ "view_strings.sections_tags.search_tags" | t }}"
                aria-label="{{ "view_strings.sections_tags.search_tags" | t }}"
                class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#search"></use></svg>
        </button>
        {% if search != blank %}
          <a href="{{ clearSearchHref }}" class="shrink-0 text-sm font-medium text-indigo-600 hover:text-indigo-800">{{ "view_strings.sections_tags.clear_search" | t }}</a>
        {% endif %}
      </div>
    </form>
    {% feature_fragment publish/tags-sync %}
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
    <table class="w-full min-w-[620px] text-left"{% if search == blank %} data-reorder="/admin/tags/batch-weight" data-reorder-key="updates" data-reorder-handle-only{% endif %}>
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          {% if search == blank %}<th class="w-10 px-3 py-3"></th>{% endif %}
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_tags.name" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_tags.weight" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_tags.type" | t }}</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% if hasTags %}
          {% for tag in tags %}
            <tr class="hover:bg-gray-50" data-id="{{ tag.id }}">
              {% if search == blank %}
                <td class="px-3 py-3 text-gray-300">
                  <span data-reorder-handle title="{{ "view_strings.sections_tags.drag_to_reorder" | t }}" aria-label="{{ "view_strings.sections_tags.drag_to_reorder" | t }}" class="inline-flex h-8 w-8 cursor-grab items-center justify-center rounded-md hover:bg-gray-100 hover:text-gray-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#menu"></use></svg>
                  </span>
                </td>
              {% endif %}
              <td class="px-6 py-3 text-sm font-medium text-gray-900">
                <a href="{{ tag.editHref }}" class="block text-sm font-medium text-indigo-600 hover:text-indigo-800">{{ tag.name }}</a>
                <div class="text-xs font-mono text-gray-500">{{ tag.slug }}</div>
              </td>
              <td class="px-6 py-3 text-sm text-gray-500">{{ tag.weight }}</td>
              <td class="px-6 py-3 text-sm text-gray-500">{{ tag.taxonomyName }}</td>
              <td class="px-6 py-3 text-right">
                <a href="{{ tag.editHref }}"
                   title="{{ "view_strings.sections_tags.edit" | t }}"
                   aria-label="{{ "view_strings.sections_tags.edit" | t }} {{ tag.name }}"
                   class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-800">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
                  <span class="sr-only">{{ "view_strings.sections_tags.edit" | t }}</span>
                </a>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          {% if search != blank %}
            <tr><td colspan="4" class="px-6 py-10 text-center text-gray-400">{{ "view_strings.sections_tags.no_matching_tags" | t }}</td></tr>
          {% else %}
            <tr><td colspan="5" class="px-6 py-10 text-center text-gray-400">{{ "view_strings.sections_tags.no_tags_yet" | t }}</td></tr>
          {% endif %}
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
