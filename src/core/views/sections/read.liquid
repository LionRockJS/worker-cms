<div class="min-w-0 max-w-4xl my-4 px-4 sm:px-6 lg:px-8">
  <div class="mb-6 flex items-center gap-3">
    <a href="{{ backHref }}" class="shrink-0 text-gray-400 transition-colors hover:text-gray-600" aria-label="{{ "common.back" | t }}">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="{{ iconHrefPrefix }}#arrow-left"></use></svg>
    </a>
    <h2 class="min-w-0 break-words text-2xl font-bold text-gray-900">{{ pageName }}</h2>
    <span class="ml-1 shrink-0 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-gray-500">{{ "read.read_only" | t }}</span>
    {% if editHref != blank %}
      <a href="{{ editHref }}"
         class="ml-auto inline-flex shrink-0 items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
        {{ "common.edit" | t }}
      </a>
    {% endif %}
    {% if pageAccessHref != blank %}<a class="text-indigo-600" href="{{ pageAccessHref }}">{{ "page_access.title" | t }}</a>{% endif %}
  </div>

  {% if versionCreatedAt != blank %}
    <div class="mb-4 flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#clock"></use></svg>
      {{ "read.viewing_version_prefix" | t }} {{ versionCreatedAt }} {{ "read.viewing_version_suffix" | t }}
      <a href="{{ readBase }}" class="font-semibold underline">{{ "read.view_current" | t }}</a>
    </div>
  {% endif %}

  <div class="space-y-6">
    <div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
      <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {%- assign metaLabels = "view_strings.sections_editor.slug,read.type,read.weight,read.parent,read.from,read.until,read.timezone" | split: "," -%}
        {%- assign metaValues = "slug,type,weight,parent,start,end,timezone" | split: "," -%}
        {%- for key in metaValues -%}
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ metaLabels[forloop.index0] | t }}</dt>
            <dd class="mt-0.5 min-w-0 break-words text-sm text-gray-800">{% render "snippets/read-value.liquid", value: meta[key] %}</dd>
          </div>
        {%- endfor -%}
        <div class="min-w-0">
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ "view_strings.sections_editor.editors" | t }}</dt>
          <dd class="mt-0.5 min-w-0 break-words text-sm text-gray-800"><div class="flex flex-wrap gap-1.5">
            {%- for editor in meta.editors -%}
              <span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">{{ editor }}</span>
            {% else -%}
              <span class="text-gray-400">&mdash;</span>
            {%- endfor -%}
          </div></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ "view_strings.sections_editor.last_modified_by" | t }}</dt>
          <dd class="mt-0.5 min-w-0 break-words text-sm text-gray-800">{% render "snippets/read-value.liquid", value: meta.modifier %}</dd>
        </div>
      </dl>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ "view_strings.snippets_structured_editor.language" | t }}</span>
      {% for option in languages %}
        <a href="{{ option.href }}"
           class="inline-flex items-center rounded-lg border px-2.5 py-1 text-xs {% if option.selected %}border-indigo-400 bg-indigo-50 text-indigo-700{% else %}border-gray-300 bg-white text-gray-600 hover:bg-gray-50{% endif %}">{{ option.value }}</a>
      {% endfor %}
    </div>

    {% if structured.settings %}
      <section class="min-w-0 space-y-3">
        <p class="text-sm font-semibold text-gray-700">{{ "view_strings.snippets_structured_editor.settings" | t }}</p>
        {% render "snippets/read-fieldset.liquid", set: structured.settings %}
      </section>
    {% endif %}
    <div class="min-w-0 space-y-5 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
      <p class="text-sm font-semibold text-gray-700">{{ "view_strings.snippets_structured_editor.content" | t }}</p>
      {% render "snippets/read-fieldset.liquid", set: structured.content %}
      <div class="space-y-4 border-t border-gray-100 pt-5">
        <p class="text-sm font-semibold text-gray-700">{{ "view_strings.snippets_structured_editor.blocks" | t }}</p>
        {% for block in structured.blocks %}
          <div class="min-w-0 space-y-4 rounded-lg border border-gray-200 p-4">
            <p class="min-w-0 break-words text-xs font-semibold uppercase tracking-wide text-gray-500">{{ block.name }}</p>
            {% if block.settings %}
              <div class="space-y-3"><p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ "view_strings.snippets_structured_editor.settings" | t }}</p>{% render "snippets/read-fieldset.liquid", set: block.settings %}</div>
            {% endif %}
            {% render "snippets/read-fieldset.liquid", set: block.content %}
          </div>
        {% else %}
          <p class="text-sm text-gray-400">{{ "read.no_blocks" | t }}</p>
        {% endfor %}
      </div>
    </div>

    {% if tagGroups.size > 0 %}
      <div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <p class="mb-3 text-sm font-medium text-gray-700">{{ "view_strings.sections_editor.tags" | t }}</p>
        <div class="space-y-4">
          {% for group in tagGroups %}
            <div class="min-w-0 space-y-2">
              <p class="min-w-0 break-words text-xs font-semibold uppercase tracking-wide text-gray-400">{{ group.name }}</p>
              <div class="flex flex-wrap gap-2">
                {% for tag in group.tags %}<span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-sm text-gray-700">{{ tag }}</span> {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if versions.size > 0 %}
      <div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <p class="mb-3 text-sm font-semibold text-gray-700">{{ "view_strings.sections_editor.versions" | t }}</p>
        <div class="flex flex-wrap gap-2">
          {% for entry in versions %}
            <a href="{{ entry.href }}"
               class="min-w-0 break-words rounded-lg border px-3 py-1.5 text-xs {% if entry.active %}border-amber-400 bg-amber-50 text-amber-800{% else %}border-gray-300 bg-white text-gray-700 hover:bg-gray-50{% endif %}">{{ entry.label }}{% if entry.live %}{{ liveBadgeHtml | raw }}{% endif %}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      {% if editHref != blank %}<a href="{{ editHref }}" class="w-full rounded-lg bg-indigo-600 px-6 py-2 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 sm:w-auto">{{ "common.edit" | t }}</a>{% endif %}
      <a href="{{ backHref }}" class="w-full rounded-lg border border-gray-300 bg-white px-6 py-2 text-center text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 sm:w-auto">{{ "common.back" | t }}</a>
    </div>
  </div>
</div>
