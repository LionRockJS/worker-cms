{% assign actionsWidth = 'max-w-full' %}
{% if section.settings.width == '4xl' %}{% assign actionsWidth = 'max-w-4xl' %}{% elsif section.settings.width == '3xl' %}{% assign actionsWidth = 'max-w-3xl' %}{% elsif section.settings.width == '2xl' %}{% assign actionsWidth = 'max-w-2xl' %}{% elsif section.settings.width == 'xl' %}{% assign actionsWidth = 'max-w-xl' %}{% endif %}
<div class="min-w-0 {{ actionsWidth }} px-4 pb-5 pt-4 sm:px-6 sm:pb-8 lg:px-8">
  {% if section.settings.deleteAction and section.settings.deleteAction != '' %}
    <form id="{{ section.settings.deleteFormId }}"
          method="POST"
          action="{{ section.settings.deleteAction }}"
          data-confirm="{{ section.settings.deleteConfirm }}"></form>
  {% endif %}
  <div class="flex min-w-0 flex-wrap items-center gap-3">
    {% if section.settings.showSave == 'yes' %}
      <button form="{{ section.settings.formId }}"
              type="submit"
              title="{{ section.settings.saveLabel }}"
              aria-label="{{ section.settings.saveLabel }}"
              class="inline-flex rounded-lg bg-indigo-600 px-6 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 items-center justify-center shrink-0 gap-2 h-10">
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#save"></use></svg>
        <span class="hidden lg:inline">{{ section.settings.saveLabel }}</span>
      </button>
    {% endif %}
    <a href="{{ section.settings.cancelHref }}"
       title="{{ section.settings.cancelLabel }}"
       aria-label="{{ section.settings.cancelLabel }}"
       class="inline-flex rounded-lg border border-gray-300 bg-white px-6 text-center text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 items-center justify-center shrink-0 gap-2 h-10">
      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
      <span class="hidden lg:inline">{{ section.settings.cancelLabel }}</span>
    </a>
    {% if section.settings.deleteAction and section.settings.deleteAction != '' %}
      <button form="{{ section.settings.deleteFormId }}"
              type="submit"
              title="{{ section.settings.deleteLabel }}"
              aria-label="{{ section.settings.deleteLabel }}"
              class="inline-flex rounded-lg bg-red-600 px-6 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-700 sm:ml-auto items-center justify-center shrink-0 gap-2 h-10">
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash"></use></svg>
        <span class="hidden lg:inline">{{ section.settings.deleteLabel }}</span>
      </button>
    {% endif %}
  </div>
</div>
