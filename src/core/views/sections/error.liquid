<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ status }} - {{ title }} - {{ siteTitle }}</title>
  <link rel="stylesheet" href="/assets/admin.css{{ assetRevisionQuery }}">
</head>
<body class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="text-center">
    <p class="text-6xl font-bold text-gray-300">{{ status }}</p>
    <h1 class="mt-4 text-2xl font-semibold text-gray-700">{{ heading }}</h1>
    {% if hasMessage %}
      <p class="mt-2 text-gray-500">{{ message }}</p>
    {% endif %}
    <a href="/admin" title="{{ "view_strings.sections_error.back_to_dashboard" | t }}" aria-label="{{ "view_strings.sections_error.back_to_dashboard" | t }}"
       class="mt-6 inline-flex h-10 items-center justify-center gap-2 px-4 text-indigo-600 hover:underline">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="/assets/icons.svg{{ assetRevisionQuery }}#arrow-left"></use></svg>
      <span class="hidden lg:inline">{{ "view_strings.sections_error.back_to_dashboard" | t }}</span>
    </a>
  </div>
</body>
</html>
