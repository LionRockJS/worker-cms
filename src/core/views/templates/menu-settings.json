{
  "sections": {
    "header": {
      "type": "page-header",
      "settings": {
        "width": "3xl",
        "title": "{{ 'view_strings.sections_menu_settings.system' | t }}",
        "explanation": "{{ 'view_strings.sections_menu_settings.manage_the_admin_app_name_home_page_icon_and_sidebar_menu' | t }}"
      },
      "blocks": {
        "transfer": {
          "type": "link",
          "settings": {
            "href": "/admin/settings/transfer",
            "label": "{{ 'settings.transfer.link' | t }}",
            "icon": "download",
            "variant": "secondary"
          }
        }
      },
      "block_order": [
        "transfer"
      ]
    },
    "content": {
      "type": "menu-settings"
    },
    "actions": {
      "type": "form-actions",
      "settings": {
        "width": "3xl",
        "formId": "menu-settings-form",
        "showSave": "yes",
        "saveLabel": "{{ 'view_strings.sections_menu_settings.save' | t }}",
        "cancelHref": "/admin",
        "cancelLabel": "{{ 'view_strings.sections_menu_settings.cancel' | t }}"
      }
    }
  },
  "order": [
    "header",
    "content",
    "actions"
  ]
}
