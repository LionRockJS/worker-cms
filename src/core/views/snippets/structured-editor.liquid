{% if hasSettings %}
  <details data-cms-collapsible data-collapsible-key="root:settings" class="mb-2 min-w-0 space-y-3 [&_input]:bg-[#141a26]" open>
    <summary class="inline-flex cursor-pointer select-none list-none items-center gap-2 text-sm font-semibold text-gray-700 [&::-webkit-details-marker]:hidden">
      <svg class="h-3.5 w-3.5 shrink-0 transition-transform" data-collapsible-icon fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-right"></use></svg>
      <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#settings"></use></svg>
      <span>{{ "view_strings.snippets_structured_editor.settings" | t }}</span>
    </summary>
    <div class="mb-8">
    {{ settingsHtml | raw }}
    </div>
  </details>
{% endif %}

<div class="min-w-0 rounded-xl border border-gray-200 bg-white p-4 shadow-sm space-y-5 sm:p-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700">
      <svg class="h-4 w-4 shrink-0 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#document"></use></svg>
      <span>{{ "view_strings.snippets_structured_editor.content" | t }}</span>
    </p>
    {% if hasLanguageContent %}
      <label for="structured_language" class="flex min-w-0 items-center gap-2 text-xs text-gray-500">
        {{ "view_strings.snippets_structured_editor.language" | t }}
        <select
          id="structured_language"
          name="_language"
          class="min-w-0 flex-1 px-2 py-1 border border-gray-300 rounded-lg text-xs sm:flex-none"
        >
          {% for option in languageOptions %}
            <option value="{{ option.value }}" {% if option.selected %}selected{% endif %}>{{ option.value }}</option>
          {% endfor %}
        </select>
      </label>
    {% endif %}
  </div>
  {{ contentHtml | raw }}
  <div class="border-t border-gray-100 pt-5 space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm font-semibold text-gray-700">{{ "view_strings.snippets_structured_editor.blocks" | t }}</p>
      {% if hasBlockOptions %}
        <div class="flex min-w-0 w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
          <label for="block_select" class="sr-only">{{ "view_strings.snippets_structured_editor.block_type" | t }}</label>
          <select id="block_select" name="block-select" class="min-w-0 w-full px-2 py-1 border border-gray-300 rounded-lg text-xs sm:w-auto">
            {% for option in blockOptions %}
              <option value="{{ option.value }}">{{ option.value }}</option>
            {% endfor %}
          </select>
          <button type="submit" name="action" value="block-add"
                  title="{{ "view_strings.snippets_structured_editor.add_block" | t }}"
                  aria-label="{{ "view_strings.snippets_structured_editor.add_block" | t }}"
                  class="inline-flex shrink-0 px-3 rounded-lg bg-gray-900 text-white text-xs font-semibold items-center justify-center gap-2 h-8">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#plus"></use></svg>
            <span class="hidden lg:inline">{{ "view_strings.snippets_structured_editor.add_block" | t }}</span>
          </button>
        </div>
      {% endif %}
    </div>
    {% if hasBlocks %}
      {% assign sortedBlocks = blocks | sort: 'weight' %}
      {% for block in sortedBlocks %}
        <div class="min-w-0 rounded-lg border border-gray-200 p-4 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="min-w-0 break-words text-xs font-semibold uppercase tracking-wide text-gray-500">{{ block.name }}</p>
            <div class="flex shrink-0 items-center gap-3">
              <div class="flex items-center gap-1 text-sm text-gray-500">
                <span aria-hidden="true">#</span>
                <label for="{{ block.weightInputId }}" class="sr-only">Weight for {{ block.name }}</label>
                <input type="number" id="{{ block.weightInputId }}" name="{{ block.weightInputName }}"
                       value="{{ block.weight }}"
                       class="w-12 border-b border-transparent bg-transparent p-0 text-right text-lg font-bold focus:border-indigo-500 focus:outline-none">
              </div>
              <button type="submit" name="action" value="{{ block.deleteAction }}"
                      title="{{ "view_strings.snippets_structured_editor.delete_block" | t }}"
                      aria-label="{{ "view_strings.snippets_structured_editor.delete_block" | t }}"
                      class="inline-flex text-xs font-semibold text-red-600 hover:text-red-700 items-center justify-center shrink-0 gap-2 h-8 min-w-8">
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash"></use></svg>
                <span class="hidden lg:inline">{{ "view_strings.snippets_structured_editor.delete_block" | t }}</span>
              </button>
            </div>
          </div>
          <input type="hidden" name="#{{ block.index }}@_type" value="{{ block.type }}">
          <input type="hidden" name="#{{ block.index }}@_id" value="{{ block.id }}">
          {% if block.hasSettings %}
            <div class="space-y-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ "view_strings.snippets_structured_editor.settings" | t }}</p>
              {{ block.settingsHtml | raw }}
            </div>
          {% endif %}
          {{ block.contentHtml | raw }}
        </div>
      {% endfor %}
    {% else %}
      <p class="text-sm text-gray-400">{{ "view_strings.snippets_structured_editor.no_blocks_yet" | t }}</p>
    {% endif %}
  </div>
</div>