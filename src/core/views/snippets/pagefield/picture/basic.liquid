<div class="min-w-0 lg:flex lg:items-start" data-picture-field>
  <label for="{{ field.id }}" class="w-full lg:max-w-[100px] lg:me-2 block text-sm font-medium text-gray-700 leading-[1.2] mb-1 lg:mb-0 overflow-hidden">{% if field.labelKey != blank %}{{ field.labelKey | t }}{% else %}{{ field.label }}{% endif %}{% if field.required %} *{% endif %}</label>
  <div class="flex min-w-0 items-center gap-3">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-gray-50 text-gray-400">
      {% if field.value != blank %}
        <img data-picture-preview src="{{ field.value }}" alt="" class="h-full w-full object-cover">
      {% else %}
        <img data-picture-preview src="" alt="" class="hidden h-full w-full object-cover">
        <span data-picture-empty class="text-xs">{{ "view_strings.snippets_pagefield_picture_basic.image" | t }}</span>
      {% endif %}
    </div>
    <div class="min-w-0 flex-1 space-y-2">
      <input id="{{ field.id }}" data-picture-url type="text" name="{{ field.inputName }}"
             value="{{ field.value }}"
             placeholder="{{ "view_strings.snippets_pagefield_picture_basic.media_upload" | t }}"
             class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
             {% if field.required %}required{% endif %}>
      {% feature_fragment media/picture-upload %}
    </div>
  </div>
</div>
