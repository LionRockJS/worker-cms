<div class="my-4 px-4 sm:px-6 lg:px-8">
  {% if hasFlash %}
    <div class="mb-4 px-4 py-2 rounded-lg bg-amber-50 text-amber-800 text-sm">{{ flashMessageKey | t }}</div>
  {% endif %}

  {% if showTaxonomyCapability %}
    <form method="post" action="{{ taxonomyAction }}" class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-4">
      <div>
        <h3 class="font-semibold">{{ "view_strings.sections_plugin_page_types.create_taxonomies" | t }}</h3>
        <p class="text-sm text-gray-600">{{ "view_strings.sections_plugin_page_types.create_taxonomies_help" | t }}</p>
        <span class="text-xs">{% if taxonomyApproved %}{{ "view_strings.sections_plugin_page_types.status_approved" | t }}{% else %}{{ "view_strings.sections_plugin_page_types.status_not_approved" | t }}{% endif %}</span>
      </div>
      <button type="submit" class="rounded-md border border-gray-300 px-3 py-2 text-sm font-semibold">{% if taxonomyApproved %}{{ "view_strings.sections_plugin_page_types.revoke" | t }}{% else %}{{ "view_strings.sections_plugin_page_types.approve" | t }}{% endif %}</button>
    </form>
  {% endif %}

  {% if unreachable %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-sm text-gray-500">
      {{ "view_strings.sections_plugin_page_types.this_plugin_is_not_reachable_right_now_so_its_page_types_and_taxonomies_" | t }}
    </div>
  {% else %}
    {% if hasDefinedPageTypes %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="flex items-center justify-between gap-4" style="padding:1rem 1rem 0;margin-bottom:.75rem">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{{ "view_strings.sections_plugin_page_types.defined_page_types" | t }}</h3>
          <p data-explanation class="mt-1 text-sm text-gray-500">{{ "view_strings.sections_plugin_page_types.page_types_contributed_by_this_plugin_through_contenttypes_blueprint" | t }}</p>
        </div>
      </div>
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.page_type" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.fields" | t }}</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody>
            {% for pageType in definedPageTypes %}
              <tr class="border-t border-gray-100">
                <td class="px-4 py-3 font-medium text-gray-900 font-mono">{{ pageType.slug }}</td>
                <td class="px-4 py-3 text-gray-500">{{ pageType.fieldCount }}</td>
                <td class="px-4 py-3 text-right">
                  <a href="{{ pageType.viewHref }}"
                     title="{{ "view_strings.sections_plugin_page_types.view" | t }}"
                     aria-label="{{ "view_strings.sections_plugin_page_types.view" | t }}"
                     class="inline-flex text-sm font-medium text-indigo-600 hover:text-indigo-800 items-center justify-center shrink-0 gap-2 h-8 min-w-8">
                    <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#eye"></use></svg>
                    <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.view" | t }}</span>
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {% if hasDefinedTaxonomies %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mt-4">
      <div class="flex items-center justify-between gap-4" style="padding:1rem 1rem 0;margin-bottom:.75rem">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{{ "view_strings.sections_plugin_page_types.defined_taxonomies" | t }}</h3>
          <p data-explanation class="mt-1 text-sm text-gray-500">{{ "view_strings.sections_plugin_page_types.taxonomies_contributed_by_this_plugin_through_contenttypes_taxonomies" | t }}</p>
        </div>
      </div>
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.name" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.slug" | t }}</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody>
            {% for taxonomy in definedTaxonomies %}
              <tr class="border-t border-gray-100">
                <td class="px-4 py-3 font-medium text-gray-900">{{ taxonomy.name }}</td>
                <td class="px-4 py-3 text-gray-500 font-mono">{{ taxonomy.slug }}</td>
                <td class="px-4 py-3 text-right">
                  <a href="{{ taxonomy.viewHref }}"
                     title="{{ "view_strings.sections_plugin_page_types.view" | t }}"
                     aria-label="{{ "view_strings.sections_plugin_page_types.view" | t }}"
                     class="inline-flex text-sm font-medium text-indigo-600 hover:text-indigo-800 items-center justify-center shrink-0 gap-2 h-8 min-w-8">
                    <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#eye"></use></svg>
                    <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.view" | t }}</span>
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {% if hasPageTypes %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 mt-4">
      <div class="flex items-center justify-between gap-4" style="padding:1rem 1rem 0;margin-bottom:.75rem">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{{ "view_strings.sections_plugin_page_types.delegated_access" | t }}</h3>
          <p data-explanation class="mt-1 text-sm text-gray-500">{{ "view_strings.sections_plugin_page_types.access_requested_through_readtypes_and_writetypes_approving_a_scope_lets" | t }}</p>
        </div>
        {% if hasPendingApprovals %}
          <form method="post" action="{{ approveAllAction }}" class="shrink-0">
            <button type="submit"
                    title="{{ "view_strings.sections_plugin_page_types.approve_all" | t }}"
                    aria-label="{{ "view_strings.sections_plugin_page_types.approve_all" | t }}"
                    class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700 shrink-0 gap-2">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#check-circle"></use></svg>
              <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.approve_all" | t }}</span>
            </button>
          </form>
        {% endif %}
      </div>
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.page_type" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.read" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_page_types.write" | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for pageType in pageTypes %}
              <tr class="border-t border-gray-100">
                <td class="px-4 py-3">
                  <div class="font-medium text-gray-900{% unless pageType.pageType == '*' %} font-mono{% endunless %}">{% if pageType.pageTypeLabelKey != '' %}{{ pageType.pageTypeLabelKey | t }}{% else %}{{ pageType.pageTypeLabel }}{% endif %}</div>
                  {% if pageType.pageType == '*' %}
                    <div class="text-xs text-gray-400 mt-0.5">{{ "view_strings.sections_plugin_page_types.wildcard_scope" | t }}</div>
                  {% endif %}
                </td>
                <td class="px-4 py-3">
                  {% if pageType.readDeclared %}
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold {{ pageType.readStatusClass }}">{{ pageType.readStatusKey | t }}</span>
                    {% if pageType.readApproved %}
                      <div class="text-xs text-gray-400 mt-0.5">{{ "view_strings.sections_plugin_page_types.approved_by" | t }} {{ pageType.readApprovedBy }}</div>
                      <form method="post" action="{{ pageType.revokeReadAction }}" class="mt-2 inline" data-confirm="{{ "view_strings.sections_plugin_page_types.revoke_read_confirmation" | t }}">
                        <input type="hidden" name="page_type" value="{{ pageType.pageType }}">
                        <input type="hidden" name="access" value="read">
                        <button type="submit"
                                title="{{ "view_strings.sections_plugin_page_types.revoke" | t }}"
                                aria-label="{{ "view_strings.sections_plugin_page_types.revoke" | t }}"
                                class="inline-flex px-3 rounded-lg border border-red-300 text-xs font-semibold text-red-700 items-center justify-center shrink-0 gap-2 h-8">
                          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                          <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.revoke" | t }}</span>
                        </button>
                      </form>
                    {% else %}
                      <form method="post" action="{{ pageType.approveReadAction }}" class="mt-2 inline">
                        <input type="hidden" name="page_type" value="{{ pageType.pageType }}">
                        <input type="hidden" name="access" value="read">
                        <button type="submit"
                                title="{{ "view_strings.sections_plugin_page_types.approve" | t }}"
                                aria-label="{{ "view_strings.sections_plugin_page_types.approve" | t }}"
                                class="inline-flex px-3 rounded-lg bg-indigo-600 text-xs font-semibold text-white items-center justify-center shrink-0 gap-2 h-8">
                          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#check-circle"></use></svg>
                          <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.approve" | t }}</span>
                        </button>
                      </form>
                    {% endif %}
                  {% else %}
                    <span class="text-xs text-gray-400">{{ "view_strings.sections_plugin_page_types.not_requested" | t }}</span>
                  {% endif %}
                </td>
                <td class="px-4 py-3">
                  {% if pageType.writeDeclared %}
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold {{ pageType.writeStatusClass }}">{{ pageType.writeStatusKey | t }}</span>
                    {% if pageType.writeApproved %}
                      <div class="text-xs text-gray-400 mt-0.5">{{ "view_strings.sections_plugin_page_types.approved_by" | t }} {{ pageType.writeApprovedBy }}</div>
                      <form method="post" action="{{ pageType.revokeWriteAction }}" class="mt-2 inline" data-confirm="{{ "view_strings.sections_plugin_page_types.revoke_write_confirmation" | t }}">
                        <input type="hidden" name="page_type" value="{{ pageType.pageType }}">
                        <input type="hidden" name="access" value="write">
                        <button type="submit"
                                title="{{ "view_strings.sections_plugin_page_types.revoke" | t }}"
                                aria-label="{{ "view_strings.sections_plugin_page_types.revoke" | t }}"
                                class="inline-flex px-3 rounded-lg border border-red-300 text-xs font-semibold text-red-700 items-center justify-center shrink-0 gap-2 h-8">
                          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#x"></use></svg>
                          <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.revoke" | t }}</span>
                        </button>
                      </form>
                    {% else %}
                      <form method="post" action="{{ pageType.approveWriteAction }}" class="mt-2 inline">
                        <input type="hidden" name="page_type" value="{{ pageType.pageType }}">
                        <input type="hidden" name="access" value="write">
                        <button type="submit"
                                title="{{ "view_strings.sections_plugin_page_types.approve" | t }}"
                                aria-label="{{ "view_strings.sections_plugin_page_types.approve" | t }}"
                                class="inline-flex px-3 rounded-lg bg-indigo-600 text-xs font-semibold text-white items-center justify-center shrink-0 gap-2 h-8">
                          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#check-circle"></use></svg>
                          <span class="hidden lg:inline">{{ "view_strings.sections_plugin_page_types.approve" | t }}</span>
                        </button>
                      </form>
                    {% endif %}
                  {% else %}
                    <span class="text-xs text-gray-400">{{ "view_strings.sections_plugin_page_types.not_requested" | t }}</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}
  {% endif %}
</div>
