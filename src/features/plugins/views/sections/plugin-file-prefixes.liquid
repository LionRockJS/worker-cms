<div class="my-4 px-4 sm:px-6 lg:px-8">
  {% if hasFlash %}
    <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-700">{{ flashMessageKey | t }}</div>
  {% endif %}

  {% if unreachable %}
    <div class="rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-500">
      {{ "view_strings.sections_plugin_file_prefixes.this_plugin_is_not_reachable_right_now_so_its_declared_file_prefixes_can_t_be_l" | t }}
    </div>
  {% else %}
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between gap-4" style="padding:1rem 1rem 0;margin-bottom:.75rem">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{{ "view_strings.sections_plugin_file_prefixes.file_prefixes" | t }}</h3>
          <p class="mt-1 text-sm text-gray-500">{{ "view_strings.sections_plugin_file_prefixes.approval_reserves_the_prefix_for_this_plugin_and_blocks_overlapping_prefixes" | t }}</p>
        </div>
      </div>
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_file_prefixes.prefix" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_file_prefixes.status" | t }}</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody>
            {% if hasPrefixes %}
              {% for prefix in prefixes %}
                <tr class="border-t border-gray-100">
                  <td class="px-4 py-3">
                    <div class="font-mono font-medium text-gray-900 break-all">{{ prefix.prefix }}</div>
                    {% if prefix.approved %}
                      <div class="mt-0.5 text-xs text-gray-400">{{ "view_strings.sections_plugin_file_prefixes.approved_by" | t }} {{ prefix.approvedBy }}</div>
                    {% elsif prefix.conflict %}
                      <div class="mt-0.5 text-xs text-red-600">{{ "view_strings.sections_plugin_file_prefixes.reserved_by" | t }} {{ prefix.conflictPluginId }}</div>
                    {% endif %}
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-block rounded-full px-2 py-0.5 text-xs font-semibold {{ prefix.statusClass }}">{{ prefix.statusKey | t }}</span>
                  </td>
                  <td class="px-4 py-3 text-right whitespace-nowrap">
                    {% if prefix.approved %}
                      <form method="post" action="{{ prefix.revokeAction }}" class="inline" data-confirm="{{ "view_strings.sections_plugin_file_prefixes.revoke_confirmation" | t }}">
                        <input type="hidden" name="prefix" value="{{ prefix.prefix }}">
                        <button type="submit" class="rounded-lg border border-red-300 px-3 py-1 text-xs font-semibold text-red-700">{{ "view_strings.sections_plugin_file_prefixes.revoke" | t }}</button>
                      </form>
                    {% elsif prefix.conflict %}
                      <span class="text-xs text-gray-400">{{ "view_strings.sections_plugin_file_prefixes.not_available" | t }}</span>
                    {% else %}
                      <form method="post" action="{{ prefix.approveAction }}" class="inline">
                        <input type="hidden" name="prefix" value="{{ prefix.prefix }}">
                        <button type="submit" class="rounded-lg bg-indigo-600 px-3 py-1 text-xs font-semibold text-white">{{ "view_strings.sections_plugin_file_prefixes.approve" | t }}</button>
                      </form>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500">{{ "view_strings.sections_plugin_file_prefixes.this_plugin_declares_no_file_prefixes" | t }}</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}
</div>
