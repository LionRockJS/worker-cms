<div class="my-4 px-4 sm:px-6 lg:px-8">
  {% if hasFlash %}
    <div class="mb-4 px-4 py-2 rounded-lg bg-amber-50 text-amber-800 text-sm">{{ flashMessageKey | t }}</div>
  {% endif %}

  {% if unreachable %}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-sm text-gray-500">
      {{ "view_strings.sections_plugin_credits.this_plugin_is_not_reachable_right_now_so_its_declared_credit_costs_can_" | t }}
    </div>
  {% else %}
    <form method="post" action="{{ saveAction }}">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_credits.action" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_credits.charged" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_credits.effective_price" | t }}</th>
              <th class="px-4 py-2">{{ "view_strings.sections_plugin_credits.configure" | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% if hasCredits %}
              {% for credit in credits %}
                <tr class="border-t border-gray-100">
                  <td class="px-4 py-3">
                    <div class="font-medium text-gray-900">{{ credit.label }}</div>
                    <div class="text-xs text-gray-400 mt-0.5 font-mono">{{ credit.key }}</div>
                    {% if credit.description != '' %}<div data-explanation class="text-xs text-gray-500 mt-0.5">{{ credit.description }}</div>{% endif %}
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-700">{{ credit.chargeKey | t }} {{ credit.chargeDetail }}</td>
                  <td class="px-4 py-3">
                    <div class="text-sm text-gray-700">{% if credit.effectiveKey != '' %}{{ credit.effectiveKey | t }}{% else %}{{ credit.effectiveLabel }} {{ credit.currencyKey | t }}{% endif %}{% if credit.usesDefault %} ({{ "view_strings.sections_plugin_credits.default" | t }}){% endif %}</div>
                    <div class="text-xs text-gray-400 mt-0.5">{{ "view_strings.sections_plugin_credits.default" | t }}: {% if credit.defaultKey != '' %}{{ credit.defaultKey | t }}{% else %}{{ credit.defaultLabel }} {{ credit.currencyKey | t }}{% endif %}</div>
                  </td>
                  <td class="px-4 py-3">
                    <input name="value_{{ credit.key }}" type="number" min="0" step="1" value="{{ credit.value }}" placeholder="{{ "view_strings.sections_plugin_credits.default" | t }}" aria-describedby="currency_{{ credit.key }}"
                           class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    <div id="currency_{{ credit.key }}" class="text-xs text-gray-500 mt-1">{{ credit.currencyKey | t }}</div>
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="4" class="px-4 py-8 text-center text-sm text-gray-500">{{ "view_strings.sections_plugin_credits.this_plugin_declares_no_chargeable_actions" | t }}</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
      {% if hasCredits %}
        <div class="mt-4">
          <button type="submit"
                  title="{{ "view_strings.sections_plugin_credits.save_prices" | t }}"
                  aria-label="{{ "view_strings.sections_plugin_credits.save_prices" | t }}"
                  class="inline-flex px-3 rounded-lg bg-indigo-600 text-xs font-semibold text-white items-center justify-center shrink-0 gap-2 h-8">
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#save"></use></svg>
            <span class="hidden lg:inline">{{ "view_strings.sections_plugin_credits.save_prices" | t }}</span>
          </button>
        </div>
      {% endif %}
    </form>
  {% endif %}

  {% if hasWallet %}
    <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900">{{ "view_strings.sections_plugin_credits.plugin_wallet" | t }}</h2>
      <p data-explanation class="text-sm text-gray-500 mt-1">{{ "view_strings.sections_plugin_credits.plugin_wallet_explanation" | t }}</p>
      <dl class="mt-4 flex flex-wrap gap-6">
        {% for entry in wallets %}
          <div>
            <dt class="text-xs uppercase text-gray-500">{{ entry.currencyKey | t }}</dt>
            <dd class="text-2xl font-semibold text-gray-900">{{ entry.balance }}</dd>
          </div>
        {% endfor %}
      </dl>
      {% if hasWalletLedger %}
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2">{{ "common.when" | t }}</th>
                <th class="px-4 py-2">{{ "common.action" | t }}</th>
                <th class="px-4 py-2">{{ "common.change" | t }}</th>
                <th class="px-4 py-2">{{ "common.balance" | t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for entry in walletLedger %}
                <tr class="border-t border-gray-100">
                  <td class="px-4 py-3 text-xs text-gray-500">{{ entry.createdAt | l10n_date }}</td>
                  <td class="px-4 py-3">
                    <span class="font-mono text-xs">{{ entry.action }}</span>
                    {% if entry.note != '' %}<div class="text-xs text-gray-500 mt-0.5">{{ entry.note }}</div>{% endif %}
                  </td>
                  <td class="px-4 py-3 text-sm {% if entry.isSpend %}text-red-700{% else %}text-green-700{% endif %}">{{ entry.delta }} {{ entry.unitKey | t }}</td>
                  <td class="px-4 py-3 text-sm text-gray-700">{{ entry.balanceAfter }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="mt-4 text-sm text-gray-500">{{ "view_strings.sections_plugin_credits.plugin_wallet_empty" | t }}</p>
      {% endif %}
    </div>
  {% endif %}
</div>
