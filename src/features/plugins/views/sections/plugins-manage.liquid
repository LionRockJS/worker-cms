<div class="my-4 px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
    <table class="w-full min-w-[560px] text-left text-sm mb-8">
      <thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-2">{{ "view_strings.sections_plugins_manage.plugin" | t }}</th>
          <th class="px-4 py-2">{{ "plugins.fields.url" | t }}</th>
          <th class="px-4 py-2">{{ "view_strings.sections_plugins_manage.status" | t }}</th>
          <th class="px-4 py-2">{{ "view_strings.sections_plugins_manage.trust" | t }}</th>
          <th class="px-4 py-2">{{ "view_strings.sections_plugins_manage.asset_status" | t }}</th>
          <th class="px-4 py-2 text-right">{{ "view_strings.sections_plugins_manage.actions" | t }}</th>
        </tr>
      </thead>
      <tbody>
        {% if hasPlugins %}
          {% for plugin in plugins %}
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3">
                <div class="font-medium text-gray-900">{{ plugin.title }}</div>
                <div class="text-xs text-gray-500">{{ plugin.subtitle }}</div>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500 break-all max-w-xs">{{ plugin.url }}</td>
              <td class="px-4 py-3">
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold {{ plugin.statusClass }}">{{ plugin.statusKey | t }}</span>
              </td>
              <td class="px-4 py-3">
                {% if plugin.trustLevelKey %}<span class="inline-block rounded-full px-2 py-0.5 text-xs font-semibold {{ plugin.trustLevelClass }}">{{ plugin.trustLevelKey | t }}</span>{% else %}<span class="text-xs text-gray-400">—</span>{% endif %}
              </td>
              <td class="px-4 py-3">
                {% if plugin.hasAssets %}
                  <div class="flex flex-wrap gap-1">
                    {% if plugin.assetNeedsApproval %}<span class="inline-block rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-semibold text-yellow-800">{{ "view_strings.sections_plugins_manage.asset_requires_approval" | t }}</span>{% endif %}
                    {% if plugin.assetNeedsUpdate %}<span class="inline-block rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800">{{ "view_strings.sections_plugins_manage.asset_requires_update" | t }}</span>{% endif %}
                    {% if plugin.assetStatusError %}<span class="inline-block rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600">{{ "view_strings.sections_plugins_manage.asset_unable_to_verify" | t }}</span>{% endif %}
                    {% unless plugin.assetNeedsApproval or plugin.assetNeedsUpdate or plugin.assetStatusError %}<span class="inline-block rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">{{ "view_strings.sections_plugins_manage.asset_approved" | t }}</span>{% endunless %}
                  </div>
                {% else %}
                  <span class="text-xs text-gray-400">—</span>
                {% endif %}
              </td>
              <td class="px-4 py-3 text-right align-top">
                <div class="flex flex-wrap justify-end gap-1.5">
                  {% if plugin.hasAssets or plugin.hasFilePrefixes or plugin.hasPageTypes or plugin.hasLimits or plugin.hasCredits %}
                    <details class="group relative inline-block shrink-0 text-left">
                      <summary class="inline-flex h-8 shrink-0 cursor-pointer list-none items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-gray-300 bg-white px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50 [&::-webkit-details-marker]:hidden">
                        {{ "view_strings.sections_plugins_manage.configuration" | t }}
                        <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#chevron-right"></use></svg>
                      </summary>
                      <div class="mt-2 rounded-lg bg-white shadow-sm absolute z-10">
                        <div class="flex flex-nowrap gap-1.5 shadow-md pb-2 pe-2">
                          {% if plugin.hasAssets %}<a href="{{ plugin.assetsHref }}" class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.sections_plugins_manage.assets" | t }}</a>{% endif %}
                          {% if plugin.hasFilePrefixes %}<a href="{{ plugin.filePrefixesHref }}" class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.sections_plugins_manage.files" | t }}</a>{% endif %}
                          {% if plugin.hasPageTypes %}<a href="{{ plugin.pageTypesHref }}" class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.sections_plugins_manage.page_types" | t }}</a>{% endif %}
                          {% if plugin.hasLimits %}<a href="{{ plugin.limitsHref }}" class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.sections_plugins_manage.limits" | t }}</a>{% endif %}
                          {% if plugin.hasCredits %}<a href="{{ plugin.creditsHref }}" class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-md border border-gray-300 px-3 text-xs font-semibold text-gray-700 hover:bg-gray-50">{{ "view_strings.sections_plugins_manage.credits" | t }}</a>{% endif %}
                        </div>
                      </div>
                    </details>
                  {% endif %}

                  <form method="post" action="{{ plugin.toggleAction }}" class="inline shrink-0">
                    <button type="submit"
                            title="{% if plugin.enabled %}{{ "plugins.actions.disable" | t }}{% else %}{{ "plugins.actions.enable" | t }}{% endif %}"
                            aria-label="{% if plugin.enabled %}{{ "plugins.actions.disable" | t }}{% else %}{{ "plugins.actions.enable" | t }}{% endif %}"
                            class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700">
                      {% if plugin.enabled %}
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#eye-off"></use></svg>
                        <span class="sr-only">{{ "plugins.actions.disable" | t }}</span>
                      {% else %}
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#eye"></use></svg>
                        <span class="sr-only">{{ "plugins.actions.enable" | t }}</span>
                      {% endif %}
                    </button>
                  </form>
                  <a href="{{ plugin.editHref }}"
                     title="{{ "view_strings.sections_plugins_manage.edit" | t }}"
                     aria-label="{{ "view_strings.sections_plugins_manage.edit" | t }}"
                     class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-indigo-600 transition-colors hover:bg-indigo-50 hover:text-indigo-800">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
                    <span class="sr-only">{{ "view_strings.sections_plugins_manage.edit" | t }}</span>
                  </a>
                  <form method="post" action="{{ plugin.deleteAction }}" class="inline shrink-0" data-confirm="{{ "view_strings.sections_plugins_manage.remove_this_plugin" | t }}">
                    <button type="submit"
                            title="{{ "view_strings.sections_plugins_manage.delete" | t }}"
                            aria-label="{{ "view_strings.sections_plugins_manage.delete" | t }}"
                            class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-red-500 transition-colors hover:bg-red-50 hover:text-red-700">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash-can"></use></svg>
                      <span class="sr-only">{{ "view_strings.sections_plugins_manage.delete" | t }}</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500">
              {{ "view_strings.sections_plugins_manage.no_plugins_registered_yet" | t }} <a class="text-indigo-600 font-medium" href="/admin/plugins-manage/new">{{ "view_strings.sections_plugins_manage.register_one" | t }}</a>.
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
