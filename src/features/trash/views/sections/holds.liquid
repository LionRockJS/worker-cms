<div class="my-4 px-4 sm:px-6 lg:px-8">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <form method="POST" action="{{ placeAction }}" class="flex flex-wrap items-center gap-2">
      <input type="text" name="uuid" required maxlength="64" aria-label="{{ "trash.page_uuid" | t }}" placeholder="{{ "trash.page_uuid" | t }}" class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm font-mono">
      <input type="text" name="reason" required maxlength="500" aria-label="{{ "trash.hold_reason" | t }}" placeholder="{{ "trash.hold_reason" | t }}" class="rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm">
      <button type="submit" class="inline-flex h-9 items-center rounded-lg border border-transparent bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">{{ "trash.place_hold" | t }}</button>
    </form>
    <a href="/admin/trash" class="text-sm text-indigo-600 hover:underline">{{ "view_strings.sections_trash.trash" | t }}</a>
  </div>

  {% if hasFlash %}
    <div id="flash" class="mb-4 rounded-lg bg-green-50 border border-green-200 p-3 text-sm text-green-700">{{ flash | t }}</div>
  {% endif %}

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
    <table class="w-full min-w-[560px] text-left">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "trash.page_uuid" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "trash.hold_reason" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "trash.placed" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_trash.actions" | t }}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% if hasHolds %}
          {% for hold in holds %}
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 text-xs text-gray-500 font-mono">{{ hold.uuid }}</td>
              <td class="px-6 py-4 text-sm text-gray-900">{{ hold.reason }}</td>
              <td class="px-6 py-4 text-sm text-gray-400">{{ hold.placedAt | l10n_date }} · #{{ hold.placedBy }}</td>
              <td class="px-6 py-4">
                {% if hold.active %}
                  <form method="POST" action="{{ hold.releaseAction }}" class="inline"
                        data-confirm="{{ "trash.release_confirm" | t }}">
                    <button type="submit" class="text-red-500 hover:text-red-700 text-sm font-medium">{{ "trash.release" | t }}</button>
                  </form>
                {% else %}
                  <span class="text-sm text-gray-400">{{ "trash.released" | t }} {{ hold.releasedAt | l10n_date }} · #{{ hold.releasedBy }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="4" class="px-6 py-12 text-center text-gray-400">{{ "trash.no_holds" | t }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

<script nonce="{{ nonce }}">
  const flash = document.getElementById('flash');
  if (flash) setTimeout(() => flash.remove(), 4000);
</script>
