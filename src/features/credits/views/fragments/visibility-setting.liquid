{% if hasCreditsFeature %}
<section class="min-w-0 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500">{{ "settings.credits.title" | t }}</h3>
  <label class="mt-4 block min-w-0 max-w-md">
    <span class="block text-sm font-medium text-gray-700 mb-1">{{ "settings.credits.show" | t }}</span>
    <select name="show_credits" class="block min-w-0 w-full max-w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
      <option value="true"{% if showCredits %} selected{% endif %}>{{ "settings.credits.visible" | t }}</option>
      <option value="false"{% unless showCredits %} selected{% endunless %}>{{ "settings.credits.hidden" | t }}</option>
    </select>
    <span data-explanation class="mt-1 block text-xs text-gray-500">{{ "settings.credits.help" | t }}</span>
  </label>
</section>
{% endif %}
