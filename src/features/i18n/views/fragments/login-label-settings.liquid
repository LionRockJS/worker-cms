{% if hasI18nFeature %}
  <section class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500">{{ "settings.login_labels.title" | t }}</h3>
    <p data-explanation class="mt-2 text-sm text-gray-500">{{ "settings.login_labels.description" | t }}</p>
    <a href="/admin/settings/translations?scope=login"
       title="{{ "settings.login_labels.edit" | t }}"
       aria-label="{{ "settings.login_labels.edit" | t }}"
       class="mt-3 inline-flex h-10 items-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 justify-center shrink-0 gap-2">
      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
      <span class="hidden lg:inline">{{ "settings.login_labels.edit" | t }}</span>
    </a>
  </section>
{% endif %}
