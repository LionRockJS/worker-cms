<div class="min-w-0 max-w-2xl my-4 px-4 sm:px-6 lg:px-8">
  {% if locked %}
    <div class="mb-4 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-sm text-gray-600">{{ "view_strings.sections_role_form.the_admin_role_always_has_every_permission_and_cannot_be_edited" | t }}</div>
  {% endif %}
  {% if hasError %}
    <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">{{ error }}</div>
  {% endif %}
  <form id="role-form" method="POST" action="{{ action }}" class="min-w-0 space-y-4">
    <label for="role_label" class="block min-w-0">
      <span class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_role_form.name" | t }}</span>
      <input id="role_label" name="label" required value="{{ label }}"{% if builtin %} readonly{% endif %} class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm{% if builtin %} bg-gray-50 text-gray-600{% endif %}">
    </label>
    {% if isNew %}
      <label for="role_name" class="block min-w-0">
        <span class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_role_form.slug" | t }}</span>
        <input id="role_name" name="name" value="{{ name }}" class="block min-w-0 w-full max-w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono">
        <span class="block text-xs text-gray-500 mt-1">{{ "view_strings.sections_role_form.optional_derived_from_the_name_if_blank_used_internally_to_identify_the_" | t }}</span>
      </label>
    {% else %}
      <div class="block min-w-0">
        <span class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_role_form.slug" | t }}</span>
        <p class="px-3 py-2 text-sm font-mono text-gray-500 bg-gray-50 border border-gray-200 rounded-lg">{{ name }}</p>
      </div>
    {% endif %}

    {% unless isNew %}
      <fieldset class="min-w-0">
        <legend class="block text-sm font-medium text-gray-700 mb-1">{{ "view_strings.sections_role_form.permissions" | t }}</legend>
        <div class="grid grid-cols-1 gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3 sm:grid-cols-2">
          {% for option in permissionOptions %}
            <label class="inline-flex items-center gap-2 rounded-md bg-white border border-gray-200 px-3 py-1.5 text-sm{% if locked %} text-gray-500{% endif %}">
              <input type="checkbox" name="permissions" value="{{ option.value }}"{% if option.checked %} checked{% endif %}{% if locked %} disabled{% endif %} class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
              <span>{{ option.label }} <span class="block text-xs text-gray-400 font-mono">{{ option.value }}</span></span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
    {% endunless %}

  </form>
  {% if canDelete %}
    <form id="role-delete-form" method="POST" action="{{ deleteAction }}" data-confirm="{{ "view_strings.sections_role_form.delete_this_role_it_will_be_removed_from_any_users_that_have_it" | t }}"></form>
  {% endif %}
  <div class="mt-4 flex min-w-0 flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
    {% unless locked %}<button form="role-form" type="submit" class="w-full px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors shadow-sm sm:w-auto">{% if isNew %}{{ "common.create" | t }}{% else %}{{ "common.save" | t }}{% endif %}</button>{% endunless %}
    <a href="/admin/roles" class="w-full px-6 py-2 text-center bg-white text-gray-700 text-sm font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors sm:w-auto">{% if locked %}{{ "common.back" | t }}{% else %}{{ "common.cancel" | t }}{% endif %}</a>
    {% if canDelete %}
      <button form="role-delete-form" type="submit" class="w-full px-6 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-sm sm:ml-auto sm:w-auto">{{ "view_strings.sections_role_form.delete" | t }}</button>
    {% endif %}
  </div>

  {% if canManageIp %}
    <form method="POST" action="{{ ipAction }}" class="mt-6 space-y-3 rounded-lg border border-gray-200 p-4">
      <label for="ip_allowlist" class="block text-sm font-medium text-gray-700">{{ "ip_access.allowlist" | t }}</label>
      <p class="text-xs text-gray-500">{{ "ip_access.description" | t }}</p>
      <textarea id="ip_allowlist" name="ip_allowlist" rows="5" maxlength="16384" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono">{{ ipAllowlist }}</textarea>
      <button type="submit" class="px-6 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700">{{ "ip_access.save" | t }}</button>
    </form>
  {% endif %}
</div>
