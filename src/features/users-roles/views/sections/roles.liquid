<div class="my-4 px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
    <table class="w-full min-w-[560px] text-left">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_roles.role" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_roles.type" | t }}</th>
          <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ "view_strings.sections_roles.permissions" | t }}</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% if hasRoles %}
          {% for role in roles %}
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 text-sm font-medium text-gray-900">{% if role.labelKey != blank %}{{ role.labelKey | t }}{% else %}{{ role.label }}{% endif %} <span class="text-gray-400 font-mono text-xs">{{ role.name }}</span></td>
              <td class="px-6 py-3 text-sm">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">{{ role.badgeKey | t }}</span>
              </td>
              <td class="px-6 py-3 text-sm text-gray-700">{{ role.permissionCount }}</td>
              <td class="px-6 py-3 text-right whitespace-nowrap">
                <a href="{{ role.editHref }}"
                   title="{{ "view_strings.sections_roles.edit" | t }}"
                   aria-label="{{ "view_strings.sections_roles.edit" | t }}"
                   class="inline-flex text-sm font-medium text-indigo-600 hover:text-indigo-800 items-center justify-center shrink-0 gap-2 h-8 min-w-8">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
                  <span class="hidden lg:inline">{{ "view_strings.sections_roles.edit" | t }}</span>
                </a>
                {% if role.canDelete %}
                  <form method="POST" action="{{ role.deleteAction }}" class="inline" data-confirm="{{ "view_strings.sections_roles.delete_this_role_it_will_be_removed_from_any_users_that_have_it" | t }}">
                    <button type="submit"
                            title="{{ "view_strings.sections_roles.delete" | t }}"
                            aria-label="{{ "view_strings.sections_roles.delete" | t }}"
                            class="inline-flex ml-3 text-sm font-medium text-red-600 hover:text-red-700 items-center justify-center shrink-0 gap-2 h-8 min-w-8">
                      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ iconHrefPrefix }}#trash"></use></svg>
                      <span class="hidden lg:inline">{{ "view_strings.sections_roles.delete" | t }}</span>
                    </button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr><td colspan="4" class="px-6 py-10 text-center text-gray-400">{{ "view_strings.sections_roles.no_roles" | t }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
