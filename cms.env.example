# Secrets and settings for the CMS container. Copy to cms.env (gitignored):
#   cp cms.env.example cms.env && chmod 600 cms.env
# Values are passed in at container start; no rebuild needed after edits.

# Required. Signs CMS session tokens; changing it signs everyone out.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# OAuth sign-in
# ---------------------------------------------------------------------------
# Callback URL to register with every provider below:
#   <BASE_URL>/auth/callback   e.g. https://cms.local/auth/callback
# (BASE_URL is set in .env next to compose.yaml.)
#
# Enable providers as one comma-separated list, no spaces, then uncomment that
# provider's lines. Apply changes with:
#   docker compose up -d --force-recreate
# ENABLED_PROVIDERS=github,google,microsoft,apple

# --- GitHub ---------------------------------------------------------------
# Register: https://github.com/settings/developers  (OAuth Apps -> New OAuth App)
# Accepts any https callback, including .local hosts.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Google ---------------------------------------------------------------
# Register: https://console.cloud.google.com/apis/credentials
#   (Create credentials -> OAuth client ID -> Web application)
# Google rejects .local callbacks: needs a public domain as BASE_URL.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Microsoft ------------------------------------------------------------
# Register: https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
#   (New registration -> Web redirect URI; secret under Certificates & secrets)
# MICROSOFT_TENANT: common (any account), organizations, consumers, or a tenant ID.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# --- Apple ----------------------------------------------------------------
# Register: https://developer.apple.com/account/resources/identifiers/list/serviceId
#   (Services ID = APPLE_CLIENT_ID; enable Sign in with Apple, add the return URL)
# Key:      https://developer.apple.com/account/resources/authkeys/list
#   (download the .p8 key once)
# Apple rejects .local return URLs: needs a public domain as BASE_URL.
# APPLE_CLIENT_SECRET is a signed JWT, not a static string, and expires after at
# most 180 days. Mint it (and re-mint before expiry) from a repo checkout:
#   npm run apple:client-secret -- --key-file AuthKey_XXXXXXXXXX.p8 \
#     --team-id TEAMID --client-id com.example.cms
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# New users get the viewer role. Grant roles on first sign-in (applied only when
# an account is created). Use exactly one of providerUserId or email per entry.
# email works only for google and apple (verified email). For github use the
# numeric user ID ("id" at https://api.github.com/users/<username>); for
# microsoft use the account's OAuth subject.
# INITIAL_USER_ROLES='[{"provider":"github","providerUserId":"1234567","roles":["admin"]}]'

# Restrict new sign-ups to these email domains (comma-separated). Existing users
# keep access. Unset = open registration.
# ALLOWED_EMAIL_DOMAINS=example.com
