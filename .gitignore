node_modules/
dist/
.DS_Store
.test-dist/
.wrangler/
*.env
.env
.dev.vars
wrangler.production.toml
# Each clone's own deployment config, created by `npm run setup` from
# wrangler.example.toml. The one exception is wrangler.eventuai.toml, which
# Cloudflare Workers Builds deploys cms.eventuai.com from.
/wrangler.toml
/.claude
src/core/views/locales/en.default.json
*.p8

# A bare `db` pattern in a global gitignore (e.g. ~/.gitignore_global) matches
# this source directory, which silently kept src/core/db/data-classes.ts out of
# a commit while it still built locally. Re-include it explicitly.
!src/core/db/
!src/core/db/**
